@model BudgetIndexViewModel
@{
    ViewData["Title"] = "Budget Administration";
}
<header class="page-heading mock-heading">
    <div><p class="welcome-name">Administrator</p><h1>Budget Administration</h1></div>
    <a class="button-link" asp-action="Create" data-form-dialog="Create budget"><partial name="_NavIcon" model='"plus"' />Create budget</a>
</header>
    @if (TempData["BudgetNotice"] is string notice)
    {
        <p class="success-notice" role="status">@notice</p>
    }
<section class="card category-list budget-list" aria-label="Monthly budgets for the signed-in account">
    <form asp-action="Index" method="get" class="category-filters" data-busy="Loading budgets…">
        <div>
            <label asp-for="Month">Month (YYYY-MM)</label>
            <input asp-for="Month" type="month" />
        </div>
        <button type="submit">Filter</button>
        <a asp-action="Index">Clear</a>
    </form>
    @if (Model.Error is not null)
    {
        <p class="notice" role="alert">@Model.Error</p>
    }
    else if (Model.Results is { } results)
    {
        @if (results.Items.Count == 0)
        {
            <div class="category-empty"><partial name="_NavIcon" model='"budget"' /><h2>No budgets found on this page</h2></div>
        }
        else
        {
            <div class="table-scroll" tabindex="0" role="region" aria-label="Budget results">
                <table>
                    <thead>
                        <tr><th scope="col">Month</th><th scope="col">Category</th><th scope="col">Limit</th><th scope="col">Spent</th><th scope="col">Remaining</th><th scope="col">Alert threshold</th><th scope="col">Status</th><th scope="col">Actions</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var budget in results.Items)
                    {
                        <tr>
                            <td>@budget.PeriodMonth.ToString("yyyy-MM", System.Globalization.CultureInfo.InvariantCulture)</td>
                            <td>@budget.CategoryName @(budget.IsCategoryActive ? "" : "(inactive)")</td>
                            <td>@budget.LimitAmount.ToString("N2") @budget.BaseCurrency</td>
                            <td>@budget.SpentAmount.ToString("N2") @budget.BaseCurrency</td>
                            <td>@budget.RemainingAmount.ToString("N2") @budget.BaseCurrency</td>
                            <td>@(budget.AlertThresholdPct)%</td>
                            <td><span class="category-state @(budget.Status switch { "OK" => "category-state-active", "Warning" => "status-warning", _ => "status-exceeded" })">@budget.Status</span></td>
                            <td>
                                <div class="table-actions">
                                    <a asp-action="Edit" asp-route-id="@budget.BudgetId" aria-label="Edit budget for @budget.CategoryName" data-form-dialog="Edit budget"><partial name="_NavIcon" model='"edit"' />Edit</a>
                                    <a asp-action="Delete" asp-route-id="@budget.BudgetId" aria-label="Delete budget for @budget.CategoryName" data-form-dialog="Delete budget">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        <div class="category-pagination">
            @if (results.Page > 1)
            {
                <a asp-route-month="@Model.Month" asp-route-page="@(results.Page - 1)">Previous page</a>
            }
            @if ((long)results.Page * results.PageSize < results.TotalCount && (long)results.Page * results.PageSize <= int.MaxValue)
            {
                <a asp-route-month="@Model.Month" asp-route-page="@(results.Page + 1)">Next page</a>
            }
        </div>
    }
</section>
