@using System.Security.Claims
@{
    ViewData["Title"] = "Administrator Account";
    var email = User.FindFirstValue(ClaimTypes.Email);
}
<header class="page-heading mock-heading"><div><p class="welcome-name">Administrator</p><h1>Account</h1></div></header>
<div class="account-grid">
    <section class="card compact-card profile-card">
        <h2>Administrator profile</h2>
        <dl class="profile-facts">
            <div><dt>Name</dt><dd>@(string.IsNullOrWhiteSpace(User.Identity?.Name) ? "Unavailable" : User.Identity.Name)</dd></div>
            <div><dt>Email</dt><dd>@(string.IsNullOrWhiteSpace(email) ? "Unavailable in this session" : email)</dd></div>
            <div><dt>Role</dt><dd>Administrator</dd></div>
        </dl>
        <form class="account-actions" asp-controller="Account" asp-action="Logout" method="post" data-busy="Signing out…" data-confirm-logout>
            <button type="submit" class="secondary"><partial name="_NavIcon" model='"logout"' />Log out</button>
        </form>
        <p><a asp-action="SwitchPortal">Switch to the personal portal</a></p>
    </section>
    <section class="card compact-card session-card">
        <h2>Session</h2>
        <dl class="profile-facts"><div><dt>Status</dt><dd>Signed in</dd></div></dl>
        <p class="session-note"><partial name="_NavIcon" model='"info"' />Session timing is unavailable.</p>
    </section>
    <section class="card compact-card appearance-card">
        <h2>Appearance <small>Theme preference</small></h2>
        <div class="account-actions">
            <div class="mock-chips theme-options" role="group" aria-label="Appearance">
                <button type="button" data-theme-choice="light" aria-pressed="true" hidden>Light</button>
                <button type="button" data-theme-choice="dark" aria-pressed="false" hidden>Dark</button>
            </div>
            <noscript><p>Theme controls require JavaScript.</p></noscript>
        </div>
    </section>
</div>
