@model PersonalTransaction
@using PersonalFinance.AdminMvc.Authentication
@using PersonalFinance.AdminMvc.Services.Contracts
@{
    var income = Model.Type == "Income";
    var baseCurrency = (Context.Items[PersonalSession.ProfileItem] as CurrentUserResponse)?.BaseCurrency;
    var converted = baseCurrency is not null && baseCurrency != Model.CurrencyCode;
    var displayCurrency = converted ? baseCurrency! : Model.CurrencyCode;
    var displayAmount = converted ? Model.AmountBase : Model.Amount;
    var signedAmount = PersonalMoneyDisplay.Format(income ? displayAmount : -displayAmount, displayCurrency, signed: true);
}
<a class="android-entry @(income ? "income" : "expense")" asp-controller="PersonalTransactions" asp-action="Details" asp-route-id="@Model.TransactionId">
    <span class="android-entry-icon" aria-hidden="true"><partial name="_NavIcon" model='@(income ? "up" : "down")' /></span>
    <span><strong>@Model.CategoryName</strong><small>@(string.IsNullOrWhiteSpace(Model.Description) ? Model.Type : Model.Description) · @Model.TransactionDate.ToString("MMM d")</small></span>
    <span class="android-entry-money">
        <strong>@signedAmount</strong>
        @if (converted) { <small>Original @PersonalMoneyDisplay.Format(Model.Amount, Model.CurrencyCode)</small> }
    </span>
</a>
