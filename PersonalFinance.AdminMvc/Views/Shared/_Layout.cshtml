@{
    var isDashboard = string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Dashboard", StringComparison.OrdinalIgnoreCase)
        && string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Index", StringComparison.OrdinalIgnoreCase);
    var isCategories = string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Categories", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — OWLI Administrator</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <header class="topbar">
        <a class="brand" asp-controller="Dashboard" asp-action="Index">OWLI <span>Administrator</span></a>
        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Administrator"))
        {
            <nav aria-label="Administrator navigation">
                <a asp-controller="Dashboard" asp-action="Index" class="nav-link"
                   aria-current="@(isDashboard ? "page" : null)">Dashboard</a>
                <a asp-controller="Categories" asp-action="Index" class="nav-link"
                   aria-current="@(isCategories ? "page" : null)">Default categories</a>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="secondary">Sign out</button>
                </form>
            </nav>
        }
    </header>
    <main id="main" tabindex="-1">@RenderBody()</main>
    <footer>OWLI — Your Wise Money Companion</footer>
</body>
</html>
