@model string
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" width="20" height="20" stroke-width="1.7"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Model)
    {
        case "dashboard":
            <rect x="4" y="4" width="7" height="7" rx="1.5" />
            <rect x="13" y="4" width="7" height="7" rx="1.5" />
            <rect x="4" y="13" width="7" height="7" rx="1.5" />
            <rect x="13" y="13" width="7" height="7" rx="1.5" />
            break;
        case "tag":
            <path d="M3.5 12.5V4.5a1 1 0 0 1 1-1h8l8 8-9 9z" />
            <path d="M8 8h.01" />
            break;
        case "globe":
            <circle cx="12" cy="12" r="8.5" /><ellipse cx="12" cy="12" rx="3.5" ry="8.5" /><path d="M3.5 12h17" />
            break;
        case "exchange":
            <path d="M4 7h15m-4-4 4 4-4 4M20 17H5m4-4-4 4 4 4" />
            break;
        case "account":
            <circle cx="12" cy="8.5" r="3.5" />
            <path d="M5 20c.6-3.6 3.5-5.5 7-5.5s6.4 1.9 7 5.5" />
            break;
        case "sidebar":
            <rect x="3.5" y="4.5" width="17" height="15" rx="2" />
            <path d="M9.5 4.5v15" />
            break;
        case "logout":
            <path d="M10 4H5v16h5" />
            <path d="M15 8l4 4-4 4M19 12H9" />
            break;
        case "menu":
            <path d="M4 7h16M4 12h16M4 17h16" />
            break;
        case "search":
            <circle cx="11" cy="11" r="6.5" />
            <path d="m20 20-4.2-4.2" />
            break;
        case "edit":
            <path d="M4 20h4L19 9l-4-4L4 16z" />
            <path d="m13.5 6.5 4 4" />
            break;
        case "power":
            <path d="M12 3v8" />
            <path d="M6.8 6.8a7.5 7.5 0 1 0 10.4 0" />
            break;
        case "x":
            <path d="M6 6l12 12M18 6 6 18" />
            break;
        case "sun":
            <circle cx="12" cy="12" r="4" />
            <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6 7 7M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4" />
            break;
        case "moonI":
            <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" />
            break;
        case "info":
            <circle cx="12" cy="12" r="8.5" />
            <path d="M12 11v5M12 7.7h.01" />
            break;
        case "alert":
            <circle cx="12" cy="12" r="8.5" />
            <path d="M12 7.5v5.5M12 16.5h.01" />
            break;
        case "chev":
            <path d="M9 6l6 6-6 6" />
            break;
        case "chevd":
            <path d="m6 9 6 6 6-6" />
            break;
        case "chevl":
            <path d="M15 6l-6 6 6 6" />
            break;
        case "plus":
            <path d="M12 5v14M5 12h14" />
            break;
        case "up":
            <path d="M12 19V5M6 11l6-6 6 6" />
            break;
        case "down":
            <path d="M12 5v14M6 13l6 6 6-6" />
            break;
        case "mail":
            <path d="M4 6h16v12H4z" />
            <path d="m4 7 8 6 8-6" />
            break;
        case "lock":
            <path d="M6 11h12v9H6z" />
            <path d="M8.5 11V8a3.5 3.5 0 0 1 7 0v3" />
            break;
        case "sortn":
            <path d="M8 10l4-4 4 4M8 14l4 4 4-4" />
            break;
        case "sortu":
            <path d="M8 14l4-4 4 4" />
            break;
        case "sortd":
            <path d="M8 10l4 4 4-4" />
            break;
        case "refresh":
            <path d="M20 12a8 8 0 1 1-2.34-5.66" />
            <path d="M20 4v5h-5" />
            break;
        case "clock":
            <circle cx="12" cy="12" r="8.5" />
            <path d="M12 7.5V12l3 2" />
            break;
        case "budget":
            <path d="M4 6h16v13H4zM4 9h16m-5 5h2m-10 0h4" />
            break;
        case "goal":
            <circle cx="12" cy="12" r="8.5" />
            <circle cx="12" cy="12" r="4.5" />
            <circle cx="12" cy="12" r="1" fill="currentColor" />
            break;
        case "calendar":
            <rect x="4" y="5.5" width="16" height="15" rx="2" />
            <path d="M8 3.5v4M16 3.5v4M4 10h16" />
            break;
        case "report":
            <path d="M5 4h14v16H5zM9 15v2m3-5v5m3-8v8" />
            break;
        case "eye":
            <circle cx="7.5" cy="11" r="4" />
            <circle cx="16.5" cy="11" r="4" />
            <circle cx="7.5" cy="11" r="1" fill="currentColor" stroke="none" />
            <circle cx="16.5" cy="11" r="1" fill="currentColor" stroke="none" />
            <path d="M11 16.5 12 17.8 13 16.5" />
            break;
        case "filter":
            <path d="M4 6h16M7 12h10M10 18h4" />
            break;
        case "minus":
            <path d="M5 12h14" />
            break;
        case "list":
            <path d="M9 6h11M9 12h11M9 18h11" />
            <path d="M4.5 6h.01M4.5 12h.01M4.5 18h.01" />
            break;
    }
</svg>
