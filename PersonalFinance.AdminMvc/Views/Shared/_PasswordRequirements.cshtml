@* Model: the id for this list; the password input points at it with aria-describedby and data-password-rules. *@
@model string
<div class="password-rules" id="@Model">
    <p class="password-rules-title">Your password needs:</p>
    <ul>
        @foreach (var (key, label) in PersonalFinance.AdminMvc.ViewModels.PasswordPolicy.Requirements)
        {
            <li data-rule="@key"><span class="password-rule-mark" aria-hidden="true">○</span>@label<span class="visually-hidden" data-rule-state></span></li>
        }
    </ul>
</div>
