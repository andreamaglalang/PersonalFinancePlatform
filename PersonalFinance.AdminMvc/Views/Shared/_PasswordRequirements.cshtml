@* Model: the id for this list; the password input points at it with aria-describedby and data-password-rules.
   ViewData["PasswordRulesCollapsible"] = true shows a one-line hint until the field is focused or typed in. *@
@model string
@{ var collapsible = ViewData["PasswordRulesCollapsible"] is true; }
<div class="password-rules" id="@Model" data-collapsible="@(collapsible ? "true" : null)">
    @if (collapsible)
    {
        <p class="password-rules-hint">12+ characters, upper and lower case, a number and a symbol.</p>
    }
    <div class="password-rules-detail">
        <p class="password-rules-title">Your password needs:</p>
        <ul>
            @foreach (var (key, label) in PersonalFinance.AdminMvc.ViewModels.PasswordPolicy.Requirements)
            {
                <li data-rule="@key"><svg class="password-rule-mark" viewBox="0 0 16 16" aria-hidden="true"><circle class="mark-open" cx="8" cy="8" r="5.25" /><path class="mark-met" d="m4.5 8.25 2.25 2.25 4.75-5" /></svg><span>@label</span><span class="visually-hidden" data-rule-state></span></li>
            }
        </ul>
    </div>
</div>
