@model PersonalFinance.AdminMvc.ViewModels.CategoryIndexViewModel
@{ ViewData["Title"] = "Shared default categories"; }
<header class="page-heading mock-heading">
        <div>
            <p class="welcome-name">Administrator</p>
            <h1 id="categories-title">Default Categories</h1>
        </div>
        <a class="button-link" asp-action="Create" data-form-dialog="Create category"><partial name="_NavIcon" model='"plus"' />Create category</a>
</header>
@if (TempData["CategoryNotice"] is string notice)
{
    <p class="success-notice" role="status">@notice</p>
}
<section class="card category-list default-category-list admin-category-workspace" aria-labelledby="categories-title">
    <form asp-action="Index" method="get" class="category-filters" data-busy="Loading categories…">
        <label class="category-search"><partial name="_NavIcon" model='"search"' /><span class="visually-hidden">Search categories on this API page</span><input asp-for="Search" type="search" maxlength="50" placeholder="Search categories" /></label>
        <div class="filter-group">
            <span class="eyebrow" id="type-filter">Type</span>
            <div class="mock-chips" role="group" aria-labelledby="type-filter">
                @foreach (var option in new[] { (Value: "", Label: "All"), (Value: "Income", Label: "Income"), (Value: "Expense", Label: "Expense") })
                {
                    <a asp-action="Index" asp-route-Type="@option.Value" asp-route-Search="@Model.Search" asp-route-State="@Model.State" asp-route-Sort="@Model.Sort" asp-route-PageSize="@Model.PageSize"
                       aria-current="@((Model.Type ?? "") == option.Value ? "true" : null)">@option.Label</a>
                }
            </div>
        </div>
        <div class="filter-group">
            <span class="eyebrow" id="status-filter">Status</span>
            <div class="mock-chips" role="group" aria-labelledby="status-filter">
                @foreach (var option in new[] { (Value: "", Label: "All"), (Value: "active", Label: "Active"), (Value: "inactive", Label: "Inactive") })
                {
                    <a asp-action="Index" asp-route-Type="@Model.Type" asp-route-Search="@Model.Search" asp-route-State="@option.Value" asp-route-Sort="@Model.Sort" asp-route-Page="@Model.Page" asp-route-PageSize="@Model.PageSize"
                       aria-current="@((Model.State ?? "") == option.Value ? "true" : null)">@option.Label</a>
                }
            </div>
        </div>
        <input asp-for="Type" type="hidden" />
        <input asp-for="State" type="hidden" />
        <details class="category-options">
            <summary>API page options</summary>
            <label asp-for="Sort">Sort this page</label><select asp-for="Sort"><option value="name">Name A–Z</option><option value="name-desc">Name Z–A</option><option value="type">Type</option><option value="state">Active first</option></select>
            <label asp-for="Page">API page</label><input asp-for="Page" type="number" min="1" />
            <label asp-for="PageSize">Page size</label><input asp-for="PageSize" type="number" min="1" max="100" />
        </details>
        <button type="submit" class="filter-submit">Apply filters</button>
    </form>
    <div class="category-results-head">
        <div><p class="eyebrow">Shared category library</p><p class="category-result-count">@Model.Categories.Count results on this API page</p></div>
        <nav class="category-sort" aria-label="Sort categories">
            <span>Sort</span>
            @foreach (var column in new[] { (Label: "Name", Sort: Model.Sort is null or "name" ? "name-desc" : "name"), (Label: "Type", Sort: "type"), (Label: "Status", Sort: "state") })
            {
                <a asp-action="Index" asp-route-Type="@Model.Type" asp-route-Search="@Model.Search" asp-route-State="@Model.State" asp-route-Sort="@column.Sort" asp-route-Page="@Model.Page" asp-route-PageSize="@Model.PageSize" aria-current="@(Model.Sort == column.Sort ? "true" : null)">@column.Label</a>
            }
        </nav>
    </div>
    @if (Model.Error is not null)
    {
        <div class="category-empty" role="alert"><partial name="_NavIcon" model='"alert"' /><h2>We couldn’t load categories</h2><p>@Model.Error</p><a class="button-link" asp-action="Index">Reset filters</a></div>
    }
    else
    {
        @if (Model.Categories.Count == 0)
        {
            <div class="category-empty"><partial name="_NavIcon" model='"search"' /><h2>No categories match on this page</h2><p>Try a different name or browse another API page.</p><a class="button-link" asp-action="Index" asp-route-Page="@Model.Page" asp-route-PageSize="@Model.PageSize">Clear search and filters</a></div>
        }
        else
        {
            <div class="category-card-grid" role="list" aria-label="Shared default categories">
                @foreach (var category in Model.Categories)
                {
                    <article class="category-management-card" role="listitem">
                        <div class="category-card-top"><span class="category-card-icon" aria-hidden="true"><partial name="_NavIcon" model='@(category.Type == "Income" ? "up" : "down")' /></span><span class="category-state @(category.IsActive ? "category-state-active" : "category-state-inactive")">@(category.IsActive ? "Active" : "Inactive")</span></div>
                        <div class="category-card-copy"><h2>@category.Name</h2><p>@category.Type category</p>@if (category.ColorHEX is not null) { <span class="category-color-label">@category.ColorHEX</span> }</div>
                        <div class="category-card-actions">
                            <a asp-action="Edit" asp-route-id="@category.CategoryId" aria-label="Edit @category.Name" data-form-dialog="Edit category"><partial name="_NavIcon" model='"edit"' /><span>Edit</span></a>
                            <a asp-action="Edit" asp-route-id="@category.CategoryId" asp-fragment="IsActive" aria-label="@(category.IsActive ? "Deactivate" : "Activate") @category.Name"
                               data-form-dialog="@(category.IsActive ? "Deactivate category" : "Activate category")" data-dialog-status><partial name="_NavIcon" model='"power"' /><span>@(category.IsActive ? "Deactivate" : "Activate")</span></a>
                        </div>
                    </article>
                }
            </div>
        }
        <nav class="category-pagination" aria-label="Mixed API pagination">
            <span>API page @Model.Page · @Model.Categories.Count shared results</span>
            @if (Model.HasPrevious)
            { <a asp-action="Index" asp-route-Type="@Model.Type" asp-route-Search="@Model.Search" asp-route-State="@Model.State" asp-route-Sort="@Model.Sort" asp-route-Page="@(Model.Page - 1)" asp-route-PageSize="@Model.PageSize">Previous page</a> }
            @if (Model.HasNext)
            { <a asp-action="Index" asp-route-Type="@Model.Type" asp-route-Search="@Model.Search" asp-route-State="@Model.State" asp-route-Sort="@Model.Sort" asp-route-Page="@(Model.Page + 1)" asp-route-PageSize="@Model.PageSize">Next page</a> }
        </nav>
    }
</section>
