@model PersonalFinance.AdminMvc.ViewModels.CategoryCreateViewModel
@{ ViewData["Title"] = "Create shared default category"; }
<section class="card category-form" aria-labelledby="category-form-title" data-dialog-panel>
    <h1 id="category-form-title">Create category</h1>
    <p>Add a shared default category for all users.</p>
    <form asp-action="Create" method="post" data-busy="Creating category…">
        <partial name="_ValidationSummary" />
        <label asp-for="Name">Category name</label><input asp-for="Name" maxlength="50" required aria-describedby="name-error" aria-invalid="@(ViewData.ModelState["Name"]?.Errors.Count > 0 ? "true" : null)" placeholder="e.g. Groceries" data-dialog-focus />
        <span asp-validation-for="Name" id="name-error"></span>
        <fieldset class="category-choices">
            <legend>Type</legend>
            <label><input asp-for="Type" id="type-expense" type="radio" value="Expense" aria-describedby="type-error" aria-invalid="@(ViewData.ModelState["Type"]?.Errors.Count > 0 ? "true" : null)" /><partial name="_NavIcon" model='"down"' />Expense</label>
            <label><input asp-for="Type" id="type-income" type="radio" value="Income" aria-describedby="type-error" aria-invalid="@(ViewData.ModelState["Type"]?.Errors.Count > 0 ? "true" : null)" /><partial name="_NavIcon" model='"up"' />Income</label>
        </fieldset>
        <span asp-validation-for="Type" id="type-error"></span>
        <details class="category-options" open="@(!string.IsNullOrEmpty(Model.ColorHEX) || !Model.IsActive || ViewData.ModelState["ColorHEX"]?.Errors.Count > 0)">
            <summary>Color and initial status</summary>
            <partial name="_ColorPicker" model='Model.ColorHEX ?? ""' />
            <label class="check-label"><input asp-for="IsActive" /> Active for all users</label>
        </details>
        <div class="form-actions"><button type="submit">Create category</button><a asp-action="Index" data-form-dialog-cancel>Cancel</a></div>
    </form>
</section>
