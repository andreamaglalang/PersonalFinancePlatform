@model PersonalMonthlyView
@using System.Globalization
@{ ViewData["Title"] = "Insights"; }
<header class="android-heading">
    <div><p>Your financial reports</p><h1>Insights</h1></div>
    <a class="android-outline" asp-action="Index" asp-route-month="@(Model.Month is { } month ? PersonalMonth.Format(month) : null)"><partial name="_NavIcon" model='"refresh"' /> Refresh</a>
</header>
<partial name="_AndroidMonthSelector" model="Model" />
@if (Model.ReportError is not null) { <p class="notice" role="alert">@Model.ReportError</p> }
@if (Model.Report is { } report)
{
    <section class="android-hero">
        <h2>Monthly Overview</h2>
        <strong class="android-net">@PersonalMoneyDisplay.Format(report.NetCashFlow, report.BaseCurrency, signed: true)</strong>
        <p>Net transaction flow · @report.Month.ToString("MMMM yyyy")</p>
        <div class="android-flow-pair">
            <div class="income">Income <strong>@PersonalMoneyDisplay.Format(report.TotalIncome, report.BaseCurrency)</strong></div>
            <div class="expense">Expenses <strong>@PersonalMoneyDisplay.Format(report.TotalExpenses, report.BaseCurrency)</strong></div>
        </div>
        <p>@report.TransactionCount @(report.TransactionCount == 1 ? "transaction" : "transactions")</p>
        @if (report.TransactionCount == 0) { <p>No transactions were recorded for this month.</p> }
    </section>
}
<div class="android-plan-grid android-plan-section">
@if (Model.Report is { } monthly)
{
    <section class="card">
        <h2>Spending breakdown</h2>
        <partial name="_PersonalSpendingChart" model="@(new SpendingBreakdown(monthly.BaseCurrency, monthly.ExpenseByCategory, Android: true))" />
    </section>
}
<section class="card" aria-labelledby="monthly-comparison">
    <h2 id="monthly-comparison">Income and expenses by month</h2>
    @if (Model.Overview is not { } history)
    { <p role="status">Report history is temporarily unavailable.</p> }
    else if (history.Months.Count == 0)
    { <p>No months with recorded transactions yet.</p> }
    else
    {
        var max = Math.Max(1, history.Months.Max(row => Math.Max(row.Income, row.Expenses)));
        var selectedPeriod = history.Months.FirstOrDefault(row => row.Month == Model.Month);
        var previousPeriod = history.Months.FirstOrDefault(row => row.Month == Model.Previous);
        @if (selectedPeriod is not null && previousPeriod is not null)
        {
            var change = selectedPeriod.Expenses - previousPeriod.Expenses;
            <p class="android-comparison-note">
                @if (change == 0) { <text>Spending was unchanged from @previousPeriod.Month.ToString("MMMM yyyy").</text> }
                else if (previousPeriod.Expenses > 0)
                { <text>Spending was @(change > 0 ? "up" : "down") @((Math.Abs(change) / previousPeriod.Expenses).ToString("P1")) from @previousPeriod.Month.ToString("MMMM yyyy").</text> }
                else { <text>Spending was @PersonalMoneyDisplay.Format(selectedPeriod.Expenses, history.BaseCurrency) after no expenses in @previousPeriod.Month.ToString("MMMM yyyy").</text> }
            </p>
        }
        <p class="android-chart-key"><span>Income</span><span>Expenses</span></p>
        <div class="android-day-chart android-history-chart" aria-label="Monthly income and expenses">
            @foreach (var period in history.Months.OrderBy(row => row.Month))
            {
                var label = $"{period.Month:MMMM yyyy} · Income {PersonalMoneyDisplay.Format(period.Income, history.BaseCurrency)} · Expenses {PersonalMoneyDisplay.Format(period.Expenses, history.BaseCurrency)}";
                <a asp-action="Index" asp-route-month="@PersonalMonth.Format(period.Month)" title="@label" aria-label="@label" aria-current="@(period.Month == Model.Month ? "page" : null)">
                    <span class="android-day-bars" aria-hidden="true">
                        <progress class="income" max="@max.ToString(CultureInfo.InvariantCulture)" value="@period.Income.ToString(CultureInfo.InvariantCulture)"></progress>
                        <progress class="expense" max="@max.ToString(CultureInfo.InvariantCulture)" value="@period.Expenses.ToString(CultureInfo.InvariantCulture)"></progress>
                    </span>
                    @period.Month.ToString("MMM yy")
                </a>
            }
        </div>
        <details><summary>Monthly report history</summary>
            <div class="table-scroll"><table>
                <thead><tr><th scope="col">Month</th><th scope="col">Income</th><th scope="col">Expenses</th><th scope="col">Net flow</th></tr></thead>
                <tbody>
                @foreach (var period in history.Months.OrderByDescending(row => row.Month))
                {
                    <tr><th scope="row"><a asp-action="Index" asp-route-month="@PersonalMonth.Format(period.Month)">@period.Month.ToString("MMMM yyyy")</a></th>
                        <td>@PersonalMoneyDisplay.Format(period.Income, history.BaseCurrency)</td><td>@PersonalMoneyDisplay.Format(period.Expenses, history.BaseCurrency)</td>
                        <td>@PersonalMoneyDisplay.Format(period.Income - period.Expenses, history.BaseCurrency, signed: true)</td></tr>
                }
                </tbody>
            </table></div>
        </details>
    }
</section>
@if (Model.Report is { } details)
{
    <section class="card"><h2>Income by category</h2>
        <partial name="_PersonalCategoryTotals" model="details.IncomeByCategory" view-data='new ViewDataDictionary(ViewData) { ["Currency"] = details.BaseCurrency, ["AndroidMoney"] = true }' />
    </section>
    <section class="card"><h2>Savings contributions</h2><p>@PersonalMoneyDisplay.Format(details.SavingsContributed, details.BaseCurrency)</p></section>
    <section class="card android-full-row"><h2>Budget performance</h2><partial name="_PersonalBudgetTable" model="details.Budgets" /></section>
}
</div>
