@model DashboardViewModel
@{ ViewData["Title"] = "Administrator Dashboard"; }
<header class="page-heading mock-heading">
    <div><p class="welcome-name">Welcome, @Model.AdministratorDisplayName</p><h1>Dashboard</h1></div>
    <a class="button-link" asp-controller="Categories" asp-action="Create" data-form-dialog="Create category"><partial name="_NavIcon" model='"plus"' />Create category</a>
</header>
<div class="dashboard-grid">
    <section class="card dashboard-welcome" aria-labelledby="dashboard-categories">
        <img class="stars" src="~/images/dashboard-stars.svg" alt="" />
        <div class="dashboard-panel-body">
            <h2 id="dashboard-categories" class="eyebrow">Default categories</h2>
            <p class="dashboard-panel-title">Category overview</p>
            <p class="dashboard-panel-message">The API does not provide totals or a status breakdown for shared default categories.</p>
        </div>
        <div class="dashboard-panel-footer">
            <span>Role: Administrator</span>
            <a asp-controller="Categories" asp-action="Index">Manage categories <partial name="_NavIcon" model='"chev"' /></a>
        </div>
    </section>
    <div class="dashboard-tools">
        <a class="card mock-row" asp-controller="Budgets" asp-action="Index"><span class="mock-tile"><partial name="_NavIcon" model='"budget"' /></span><span><strong>Budget Administration</strong><small>Manage monthly budgets</small></span><partial name="_NavIcon" model='"chev"' /></a>
        <a class="card mock-row" asp-controller="Reports" asp-action="Index"><span class="mock-tile"><partial name="_NavIcon" model='"report"' /></span><span><strong>Financial Reports</strong><small>View monthly reports</small></span><partial name="_NavIcon" model='"chev"' /></a>
    </div>
    <section class="card dashboard-shortcuts">
        <h2>Management shortcuts</h2>
        <a class="mock-row" asp-controller="Categories" asp-action="Index"><span class="mock-tile"><partial name="_NavIcon" model='"tag"' /></span><span><strong>Manage default categories</strong><small>Search, filter, edit, activate or deactivate</small></span><partial name="_NavIcon" model='"chev"' /></a>
        <a class="mock-row" asp-controller="Categories" asp-action="Create" data-form-dialog="Create category"><span class="mock-tile"><partial name="_NavIcon" model='"plus"' /></span><span><strong>Create a category</strong><small>Add an income or expense category</small></span><partial name="_NavIcon" model='"chev"' /></a>
        <a class="mock-row" asp-controller="Categories" asp-action="Index" asp-route-state="inactive"><span class="mock-tile"><partial name="_NavIcon" model='"power"' /></span><span><strong>Review inactive categories</strong><small>Browse inactive defaults page by page</small></span><partial name="_NavIcon" model='"chev"' /></a>
    </section>
</div>
