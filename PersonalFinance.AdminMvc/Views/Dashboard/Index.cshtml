@model DashboardViewModel
@{ ViewData["Title"] = "Administrator Dashboard"; }
<header class="page-heading">
    <p class="welcome-name">Welcome, @Model.AdministratorDisplayName.</p>
    <h1>Dashboard</h1>
</header>
<section class="card dashboard-welcome" aria-labelledby="dashboard-categories">
    <h2 id="dashboard-categories">Default categories overview</h2>
    <p>The API does not provide totals or a status breakdown for shared default categories.</p>
    <dl class="reports-metrics">
        <div><dt>Total defaults</dt><dd>Unavailable</dd></div>
        <div><dt>Income / expense breakdown</dt><dd>Unavailable</dd></div>
        <div><dt>Inactive defaults</dt><dd>Unavailable</dd></div>
    </dl>
    <div class="dashboard-category-links">
        <a asp-controller="Categories" asp-action="Index">Browse default categories</a>
        <a asp-controller="Categories" asp-action="Index" asp-route-state="inactive">Browse inactive defaults page by page</a>
        <a asp-controller="Categories" asp-action="Create" data-form-dialog="Create shared default category">Create category</a>
    </div>
</section>

<section class="dashboard-features" aria-labelledby="features-title">
    <div class="section-heading">
        <h2 id="features-title">Administration</h2>
    </div>
    <div class="feature-grid">
        <article class="card feature-card" aria-labelledby="categories-title">
            <h3 id="categories-title">Default categories</h3>
            <p>Browse, create, and edit shared default categories.</p>
            <a class="button-link" asp-controller="Categories" asp-action="Index">Manage default categories</a>
        </article>
        <article class="card feature-card" aria-labelledby="budgets-title">
            <h3 id="budgets-title">Budget Administration</h3>
            <p>Manage monthly budgets for the signed-in account.</p>
            <a class="button-link" asp-controller="Budgets" asp-action="Index">Manage budgets</a>
        </article>
        <article class="card feature-card" aria-labelledby="reports-title">
            <h3 id="reports-title">Financial Reports</h3>
            <p>Report data unavailable until backend integration.</p>
            <a class="button-link" asp-controller="Reports" asp-action="Index">Open Financial Reports</a>
        </article>
    </div>
</section>
