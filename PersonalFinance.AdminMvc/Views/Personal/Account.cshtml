@model PersonalFinance.AdminMvc.Services.Contracts.CurrentUserResponse
@{
    ViewData["Title"] = "Account";
    var initials = string.Concat(Model.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2)
        .Select(part => System.Globalization.StringInfo.GetNextTextElement(part))).ToUpperInvariant();
}
<header class="android-heading"><div><h1>Account</h1></div></header>
<section class="android-hero android-profile" aria-label="Your profile">
    <span class="android-profile-avatar" aria-hidden="true">@(initials.Length == 0 ? "OW" : initials)</span>
    <h2>@Model.FullName</h2><p>@Model.Email</p>
    <span class="android-profile-status">Signed in on this device</span>
</section>
@if (TempData["PersonalProfileNotice"] is string notice) { <p class="success-notice" role="status">@notice</p> }
<div class="android-settings-grid">
    <section class="android-settings-group">
        <h2>Profile</h2>
        <details class="card" open="@(ViewData["ProfileError"] is string ? "open" : null)">
            <summary class="android-setting"><partial name="_NavIcon" model='"account"' /><span><strong>Edit profile</strong><small>Update your display name</small></span><span aria-hidden="true">›</span></summary>
            @if (ViewData["ProfileError"] is string error) { <p class="notice" role="alert">@error</p> }
            <form asp-action="Account" method="post" class="finance-form android-settings-form" data-busy="Saving display name…">
                <label for="display-name">Display name</label>
                <input id="display-name" name="FullName" value="@Model.FullName" maxlength="100" required autocomplete="name" />
                <button type="submit">Save display name</button>
            </form>
        </details>
    </section>
    <section class="android-settings-group">
        <h2>Preferences</h2>
        <details class="card" data-personal-theme-settings hidden>
            <summary class="android-setting"><partial name="_NavIcon" model='"sun"' /><span><strong>Appearance</strong><small>Choose a theme for this browser</small></span><span aria-hidden="true">›</span></summary>
            <div class="android-settings-form">
                <label for="appearance">Theme</label>
                <select id="appearance" data-personal-theme-choice>
                    <option value="light">Light</option><option value="dark">Dark</option><option value="system">System</option>
                </select>
            </div>
        </details>
        <details class="card">
            <summary class="android-setting"><partial name="_NavIcon" model='"budget"' /><span><strong>Account currency</strong><small>@(Model.BaseCurrency == "PHP" ? "Philippine peso (PHP)" : Model.BaseCurrency)</small></span><span aria-hidden="true">›</span></summary>
            <p class="android-settings-form">Reports and budget totals use @Model.BaseCurrency. Your account currency is read-only here.</p>
        </details>
    </section>
    <section class="android-settings-group">
        <h2>Finance setup</h2>
        <a class="card android-setting" asp-controller="PersonalCategories" asp-action="Index"><partial name="_NavIcon" model='"tag"' /><span><strong>Manage categories</strong><small>Expense and income categories</small></span><span aria-hidden="true">›</span></a>
        <a class="card android-setting" asp-action="Currency"><partial name="_NavIcon" model='"sortn"' /><span><strong>Currency converter</strong><small>Exchange rates from Frankfurter</small></span><span aria-hidden="true">›</span></a>
    </section>
    <section class="android-settings-group">
        <h2>Security</h2>
        <a class="card android-setting" asp-action="Password"><partial name="_NavIcon" model='"lock"' /><span><strong>Change password</strong><small>Update your account credentials</small></span><span aria-hidden="true">›</span></a>
        <form asp-action="Logout" method="post" data-busy="Signing out…"><button class="secondary android-settings-logout" type="submit">Log out</button></form>
    </section>
</div>
