@{ ViewData["Title"] = "Change password"; }
<header class="android-heading"><a class="android-outline" asp-action="Account" aria-label="Back to account"><partial name="_NavIcon" model='"chevl"' /></a><div><h1>Change password</h1></div></header>
<section class="card finance-form android-settings-editor">
    @if (ViewData["PasswordError"] is string error) { <p class="notice" role="alert">@error</p> }
    <p>Changing your password signs you out on other devices and in this browser.</p>
    <form asp-action="Password" method="post" data-busy="Changing password…">
        <label for="current-password">Current password</label>
        <input id="current-password" name="CurrentPassword" type="password" autocomplete="current-password" maxlength="128" required />
        <label for="new-password">New password</label>
        <input id="new-password" name="NewPassword" type="password" autocomplete="new-password" minlength="12" maxlength="128" required aria-describedby="password-requirements" />
        <p id="password-requirements">Use 12–128 characters with uppercase, lowercase, a digit, a symbol, and at least four distinct characters.</p>
        <label for="confirm-password">Confirm new password</label>
        <input id="confirm-password" name="ConfirmPassword" type="password" autocomplete="new-password" maxlength="128" required />
        <div class="finance-actions"><button type="submit">Change password</button><a asp-action="Account">Cancel</a></div>
    </form>
</section>
