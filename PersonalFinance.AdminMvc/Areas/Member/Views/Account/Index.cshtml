@model PersonalFinance.AdminMvc.ViewModels.MemberAccountViewModel
@{ ViewData["Title"] = "Account"; Layout = "_MemberLayout"; }
<section class="member-dashboard member-account-page">
<header class="member-dashboard-head account-heading"><div class="member-dashboard-title"><p class="owli-greeting">Your profile and settings</p><h1 class="owli-screen-title">Account</h1></div></header>
@if (Model.Notice is not null) { <p class="notice" role="status">@Model.Notice</p> }
@if (Model.Error is not null) { <p class="notice login-notice" role="alert">@Model.Error <a asp-action="Index">Refresh</a></p> }
<section class="account-profile-hero" aria-label="Your profile">
<span class="account-initials" aria-hidden="true">@(string.IsNullOrWhiteSpace(Model.Initials) ? "O" : Model.Initials)</span>
<div class="account-profile-identity"><p class="account-signed-in">Signed in</p><h2>@Model.DisplayName</h2><p>@Model.Email</p></div>
<div class="account-profile-currency"><small>Account currency</small><strong>@Model.AccountCurrency</strong></div>
</section>
<div class="account-settings-columns"><div>
<section class="account-setting-group" aria-label="Account"><h2>Account</h2><div class="account-setting-list"><a class="account-setting-row" asp-area="Member" asp-controller="Account" asp-action="Profile"><span class="account-setting-icon"><partial name="_NavIcon" model='"account"' /></span><span class="account-setting-copy"><strong>Profile</strong><small>Your name and email address</small></span><span class="account-chevron"><partial name="_NavIcon" model='"chev"' /></span></a></div></section>
<section class="account-setting-group" aria-label="Preferences"><h2>Preferences</h2><div class="account-setting-list"><a class="account-setting-row" asp-area="Member" asp-controller="Account" asp-action="Appearance"><span class="account-setting-icon"><partial name="_NavIcon" model='"sun"' /></span><span class="account-setting-copy"><strong>Appearance</strong><small>Choose how OWLI looks</small></span><span class="account-current-value" data-theme-preference>System</span><span class="account-chevron"><partial name="_NavIcon" model='"chev"' /></span></a><a class="account-setting-row" asp-area="Member" asp-controller="Currency" asp-action="Index"><span class="account-setting-icon"><partial name="_NavIcon" model='"globe"' /></span><span class="account-setting-copy"><strong>Currency</strong><small>Transaction and amount preferences</small></span><span class="account-current-value">@Model.AccountCurrency</span><span class="account-chevron"><partial name="_NavIcon" model='"chev"' /></span></a></div></section>
<section class="account-setting-group" aria-label="Finance setup"><h2>Finance setup</h2><div class="account-setting-list"><a class="account-setting-row" asp-area="Member" asp-controller="Categories" asp-action="Index"><span class="account-setting-icon"><partial name="_NavIcon" model='"category"' /></span><span class="account-setting-copy"><strong>Manage categories</strong><small>Organize income and expenses</small></span><span class="account-chevron"><partial name="_NavIcon" model='"chev"' /></span></a><a class="account-setting-row" asp-area="Member" asp-controller="CurrencyConverter" asp-action="Index"><span class="account-setting-icon"><partial name="_NavIcon" model='"exchange"' /></span><span class="account-setting-copy"><strong>Currency converter</strong><small>Explore reference exchange rates</small></span><span class="account-chevron"><partial name="_NavIcon" model='"chev"' /></span></a></div></section>
</div><div>
<section class="account-setting-group" aria-label="Security"><h2>Security</h2><div class="account-setting-list"><a class="account-setting-row" asp-area="Member" asp-controller="Account" asp-action="Password"><span class="account-setting-icon"><partial name="_NavIcon" model='"lock"' /></span><span class="account-setting-copy"><strong>Change password</strong><small>Keep your account protected</small></span><span class="account-chevron"><partial name="_NavIcon" model='"chev"' /></span></a></div></section>
<section class="account-setting-group" aria-label="About"><h2>About</h2><div class="account-setting-list"><a class="account-setting-row" asp-area="Member" asp-controller="Account" asp-action="About"><span class="account-setting-icon"><partial name="_NavIcon" model='"info"' /></span><span class="account-setting-copy"><strong>About OWLI</strong><small>Your Wise Money Companion</small></span><span class="account-chevron"><partial name="_NavIcon" model='"chev"' /></span></a></div></section>
<form asp-area="" asp-controller="Account" asp-action="Logout" method="post" data-confirm-logout class="account-logout"><button class="member-btn account-logout-button" type="submit"><partial name="_NavIcon" model='"logout"' />Log out</button></form>
</div></div></section>