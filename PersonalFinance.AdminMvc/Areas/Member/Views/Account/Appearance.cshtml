@{ ViewData["Title"] = "Appearance"; Layout = "_MemberLayout"; }
<section class="member-dashboard account-settings-page"><header class="member-dashboard-head account-heading"><div class="member-dashboard-title"><p class="owli-greeting">Make OWLI yours</p><h1 class="owli-screen-title">Appearance</h1></div></header><a class="account-back" asp-area="Member" asp-controller="Account" asp-action="Index"><partial name="_NavIcon" model='"chevl"' />Back to Account</a>
<section class="member-card account-editor"><h2>Choose your appearance</h2><p class="owli-caption">Saved in this browser. This preference is shared with the header appearance shortcut; it does not sync across devices.</p><div class="account-theme-choices" role="group" aria-label="Appearance preference">
<button type="button" data-theme-choice="light" aria-pressed="false" hidden><partial name="_NavIcon" model='"sun"' /><span><strong>Light</strong><small>A bright, clear workspace</small></span><span class="account-theme-selected" aria-hidden="true">&#10003;</span></button>
<button type="button" data-theme-choice="dark" aria-pressed="false" hidden><partial name="_NavIcon" model='"moonI"' /><span><strong>Dark</strong><small>A softer view after dark</small></span><span class="account-theme-selected" aria-hidden="true">&#10003;</span></button>
<button type="button" data-theme-choice="system" aria-pressed="false" hidden><partial name="_NavIcon" model='"dashboard"' /><span><strong>System</strong><small>Follow your device appearance</small></span><span class="account-theme-selected" aria-hidden="true">&#10003;</span></button>
</div><noscript><p>Enable JavaScript to change your browser appearance preference.</p></noscript></section></section>