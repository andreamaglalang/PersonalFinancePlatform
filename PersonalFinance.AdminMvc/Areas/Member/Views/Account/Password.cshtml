@model PersonalFinance.AdminMvc.ViewModels.MemberAccountViewModel
@{ ViewData["Title"] = "Change password"; Layout = "_MemberLayout"; }
<section class="member-dashboard account-settings-page"><header class="member-dashboard-head account-heading"><div class="member-dashboard-title"><p class="owli-greeting">Keep your account protected</p><h1 class="owli-screen-title">Change password</h1></div></header><a class="account-back" asp-area="Member" asp-controller="Account" asp-action="Index"><partial name="_NavIcon" model='"chevl"' />Back to Account</a>
<section class="member-card account-editor">@if (Model.Error is not null) { <p class="notice login-notice" role="alert">@Model.Error</p> }
<p class="owli-caption">Changing your password signs out active sessions. Sign in again with your new password.</p>
<form asp-area="Member" asp-controller="Account" asp-action="ChangePassword" method="post" class="account-form">
<div asp-validation-summary="ModelOnly" role="alert"></div>
<div class="account-field"><label asp-for="Password.CurrentPassword">Current password</label><div class="account-password-input"><input asp-for="Password.CurrentPassword" type="password" autocomplete="current-password" maxlength="128"  required /><button type="button" data-account-password-toggle="Password_CurrentPassword" aria-label="Show current password" aria-pressed="false" hidden>Show</button></div><span asp-validation-for="Password.CurrentPassword"></span></div>
<div class="account-field"><label asp-for="Password.NewPassword">New password</label><div class="account-password-input"><input asp-for="Password.NewPassword" type="password" autocomplete="new-password" maxlength="128" minlength="12" aria-describedby="password-policy" required /><button type="button" data-account-password-toggle="Password_NewPassword" aria-label="Show new password" aria-pressed="false" hidden>Show</button></div><span asp-validation-for="Password.NewPassword"></span></div>
<div class="account-field"><label asp-for="Password.ConfirmPassword">Confirm new password</label><div class="account-password-input"><input asp-for="Password.ConfirmPassword" type="password" autocomplete="new-password" maxlength="128"  required /><button type="button" data-account-password-toggle="Password_ConfirmPassword" aria-label="Show confirm new password" aria-pressed="false" hidden>Show</button></div><span asp-validation-for="Password.ConfirmPassword"></span></div>
<p class="owli-caption" id="password-policy">Use 12–128 characters, including uppercase and lowercase letters, a number, a symbol and at least four distinct characters.</p>
<div class="member-form-actions"><button class="member-btn" type="submit">Update password</button><a class="member-btn member-btn-secondary" asp-action="Index">Cancel</a></div>
</form></section></section>