@model PersonalFinance.AdminMvc.ViewModels.BudgetEditViewModel
@{
    ViewData["Title"] = "Edit budget";
    Layout = "_MemberLayout";
    var budget = (PersonalFinance.AdminMvc.Services.BudgetResponse?)ViewData["Budget"];
}
<section class="member-dashboard">
    <header class="member-dashboard-head">
        <span class="member-avatar" aria-hidden="true"><partial name="_OwlMark" /></span>
        <div class="member-dashboard-title">
            <p class="owli-greeting">Adjust a monthly limit</p>
            <h1 class="owli-screen-title">Edit budget</h1>
        </div>
        <a class="member-btn" href="@Url.Action("Index")">Back to Plan</a>
    </header>

    <div class="member-card">
        @if (budget is not null)
        {
            <p class="owli-caption">Budget for @budget.CategoryName in
                @budget.PeriodMonth.ToString("yyyy-MM", System.Globalization.CultureInfo.InvariantCulture).</p>
        }
        <form class="member-form" method="post" asp-action="Edit" asp-route-id="@(budget?.BudgetId)" data-busy>
            <div asp-validation-summary="ModelOnly" class="notice login-notice" role="alert"></div>

            <div class="member-field">
                <label class="member-label" for="LimitAmount">Limit amount</label>
                <input id="LimitAmount" name="LimitAmount" inputmode="decimal" maxlength="19" data-money-input autocomplete="off"
                       value="@(Model.LimitAmount)" />
                <span asp-validation-for="LimitAmount" class="member-field-error"></span>
            </div>

            <div class="member-field">
                <label class="member-label" for="AlertThresholdPct">Alert threshold (%)</label>
                <input id="AlertThresholdPct" name="AlertThresholdPct" type="text" inputmode="numeric" maxlength="3" data-whole-input autocomplete="off"
                       value="@(Model.AlertThresholdPct)" />
                <span asp-validation-for="AlertThresholdPct" class="member-field-error"></span>
            </div>

            <div class="member-form-actions">
                <button class="member-btn" type="submit">Save budget</button>
                <a class="member-btn member-btn-secondary" href="@Url.Action("Index")">Cancel</a>
            </div>
        </form>
    </div>
</section>
