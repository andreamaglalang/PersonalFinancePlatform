@model PersonalFinance.AdminMvc.Services.TransactionResponse
@{
    ViewData["Title"] = "Delete transaction";
    Layout = "_MemberLayout";
    var invariant = System.Globalization.CultureInfo.InvariantCulture;
}
<section class="member-dashboard">
    <header class="member-dashboard-head">
        <span class="member-avatar" aria-hidden="true"><partial name="_OwlMark" /></span>
        <div class="member-dashboard-title">
            <p class="owli-greeting">Remove a transaction</p>
            <h1 class="owli-screen-title">Delete transaction</h1>
        </div>
    </header>

    <div class="member-card">
        <dl class="member-detail">
            <dt>Date</dt>
            <dd>@Model.TransactionDate.ToString("yyyy-MM-dd", invariant)</dd>
            <dt>Description</dt>
            <dd>@(string.IsNullOrWhiteSpace(Model.Description) ? "—" : Model.Description)</dd>
            <dt>Category</dt>
            <dd>@Model.CategoryName</dd>
            <dt>Type</dt>
            <dd><span class="member-pill member-pill-@Model.Type.ToLowerInvariant()">@Model.Type</span></dd>
            <dt>Amount</dt>
            <dd class="@(Model.Type == "Income" ? "member-amount-income" : "member-amount-expense")">
                @(Model.Type == "Income" ? "+" : "−")@Model.Amount.ToString("0.00", invariant) @Model.CurrencyCode</dd>
        </dl>

        <p class="owli-caption">This cannot be undone. The transaction will be removed from your OWLI account on
            every platform.</p>

        <form class="member-form-actions" method="post" asp-action="Delete" asp-route-id="@Model.TransactionId">
            <button class="member-btn member-btn-danger" type="submit">Delete transaction</button>
            <a class="member-btn member-btn-secondary" href="@Url.Action("Index")">Cancel</a>
        </form>
    </div>
</section>
