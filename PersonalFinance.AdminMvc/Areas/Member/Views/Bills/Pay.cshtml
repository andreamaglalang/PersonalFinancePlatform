@model PersonalFinance.AdminMvc.Services.RecurringBillResponse
@{
    ViewData["Title"] = "Record a payment";
    Layout = "_MemberLayout";
    var invariant = System.Globalization.CultureInfo.InvariantCulture;
}
<section class="member-dashboard">
    <header class="member-dashboard-head">
        <span class="member-avatar" aria-hidden="true"><partial name="_OwlMark" /></span>
        <div class="member-dashboard-title">
            <p class="owli-greeting">Settle the current due date</p>
            <h1 class="owli-screen-title">Record a payment</h1>
        </div>
    </header>

    <p class="member-honest">A confirmed payment records the current due occurrence and advances the bill schedule.</p>

    <div class="member-card">
        <dl class="member-detail">
            <dt>Bill</dt><dd>@Model.Name</dd>
            <dt>Category</dt><dd>@Model.CategoryName</dd>
            <dt>Amount</dt><dd class="member-amount">@Model.Amount.ToString("0.00", invariant) @Model.CurrencyCode</dd>
            <dt>Paying due date</dt><dd>@Model.NextDueDate.ToString("yyyy-MM-dd", invariant)</dd>
        </dl>
        <p class="owli-caption">This records one expense transaction for that due date and moves the bill to the next one.</p>
        <form class="member-form-actions" method="post" asp-action="Pay" asp-route-id="@Model.BillId"><input type="hidden" name="clientId" value="@ViewData["ClientId"]" /><input type="hidden" name="dueDate" value="@(((DateOnly)ViewData["DueDate"]!).ToString("yyyy-MM-dd"))" />
            <button class="member-btn" type="submit">Record payment</button>
            <a class="member-btn member-btn-secondary" href="@Url.Action("Index")">Cancel</a>
        </form>
    </div>
</section>
