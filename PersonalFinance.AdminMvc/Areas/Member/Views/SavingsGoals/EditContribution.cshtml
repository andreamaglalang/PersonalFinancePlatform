@model PersonalFinance.AdminMvc.ViewModels.MemberContributionFormModel
@{
    ViewData["Title"] = "Edit contribution";
    Layout = "_MemberLayout";
    var goal = (PersonalFinance.AdminMvc.Services.SavingsGoalResponse)ViewData["Goal"]!;
    var contributionId = (int)ViewData["ContributionId"]!;
}
<section class="member-dashboard">
    <header class="member-dashboard-head"><span class="member-avatar" aria-hidden="true"><partial name="_OwlMark" /></span><div class="member-dashboard-title"><p class="owli-greeting">Correct a contribution in your history</p><h1 class="owli-screen-title">Edit contribution</h1></div><a class="member-btn member-btn-secondary" asp-action="Details" asp-route-id="@goal.GoalId">Back to goal</a></header>
    <div class="member-card"><form class="member-form" method="post" asp-action="EditContribution" asp-route-id="@goal.GoalId" asp-route-contributionId="@contributionId" data-busy>
        <div asp-validation-summary="ModelOnly" class="notice login-notice" role="alert"></div>
        <div class="member-field"><label class="member-label" for="Amount">Amount (@goal.BaseCurrency)</label><input id="Amount" name="Amount" inputmode="decimal" maxlength="19" value="@Model.Amount"/><span asp-validation-for="Amount" class="member-field-error"></span></div>
        <div class="member-field"><label class="member-label" for="ContributedOn">Contribution date</label><input id="ContributedOn" name="ContributedOn" type="date" value="@(Model.ContributedOn?.ToString("yyyy-MM-dd"))"/><span asp-validation-for="ContributedOn" class="member-field-error"></span></div>
        <div class="member-field"><label class="member-label" for="Note">Note (optional)</label><input id="Note" name="Note" type="text" maxlength="200" value="@Model.Note"/><span asp-validation-for="Note" class="member-field-error"></span></div>
        <div class="member-form-actions"><button class="member-btn" type="submit">Save contribution</button><a class="member-btn member-btn-secondary" asp-action="Details" asp-route-id="@goal.GoalId">Cancel</a></div>
    </form></div>
</section>
