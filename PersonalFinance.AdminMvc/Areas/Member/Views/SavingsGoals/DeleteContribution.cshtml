@model PersonalFinance.AdminMvc.Services.GoalContributionResponse
@{
    ViewData["Title"] = "Delete contribution";
    Layout = "_MemberLayout";
    var goal = (PersonalFinance.AdminMvc.Services.SavingsGoalResponse)ViewData["Goal"]!;
}
<section class="member-dashboard">
    <header class="member-dashboard-head"><span class="member-avatar" aria-hidden="true"><partial name="_OwlMark" /></span><div class="member-dashboard-title"><p class="owli-greeting">Review this change</p><h1 class="owli-screen-title">Delete contribution?</h1></div></header>
    <section class="member-card"><dl class="member-detail"><dt>Goal</dt><dd>@goal.Name</dd><dt>Amount</dt><dd>@Model.Amount.ToString("N2") @Model.BaseCurrency</dd><dt>Date</dt><dd>@Model.ContributedOn.ToString("MMM d, yyyy")</dd></dl>
        <p class="notice login-notice" role="note">The original contribution request remains in the audit ledger. Deleting this entry recalculates the goal total.</p>
        <form class="member-form" method="post" asp-action="DeleteContribution" asp-route-id="@goal.GoalId" asp-route-contributionId="@Model.ContributionId" data-busy><div asp-validation-summary="ModelOnly" class="notice login-notice" role="alert"></div><div class="member-form-actions"><button class="member-btn member-btn-danger" type="submit">Delete contribution</button><a class="member-btn member-btn-secondary" asp-action="Details" asp-route-id="@goal.GoalId">Keep it</a></div></form>
    </section>
</section>
