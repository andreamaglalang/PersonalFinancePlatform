@model PersonalFinance.AdminMvc.ViewModels.MemberContributionFormModel
@{
    ViewData["Title"] = "Add contribution";
    Layout = "_MemberLayout";
    var goal = (PersonalFinance.AdminMvc.Services.SavingsGoalResponse?)ViewData["Goal"];
}
<section class="member-dashboard">
    <header class="member-dashboard-head">
        <span class="member-avatar" aria-hidden="true"><partial name="_OwlMark" /></span>
        <div class="member-dashboard-title">
            <p class="owli-greeting">Move money towards a goal</p>
            <h1 class="owli-screen-title">Add contribution</h1>
        </div>
        <a class="member-btn" href="@Url.Action("Index")">Back to goals</a>
    </header>

    <div class="member-card">
        @if (goal is not null)
        {
            <p class="owli-caption">Goal: @goal.Name · @goal.SavedAmount.ToString("0.00") of @goal.TargetAmount.ToString("0.00") @goal.BaseCurrency saved.</p>
        }
        <form class="member-form" method="post" asp-action="Contribute" asp-route-id="@(goal?.GoalId)" data-busy>
            <div asp-validation-summary="ModelOnly" class="notice login-notice" role="alert"></div>
            <div class="member-field">
                <label class="member-label" for="Amount">Amount</label>
                <input id="Amount" name="Amount" inputmode="decimal" maxlength="19" value="@Model.Amount" />
                <span asp-validation-for="Amount" class="member-field-error"></span>
            </div>
            <div class="member-field">
                <label class="member-label" for="ContributedOn">Contribution date</label>
                <input id="ContributedOn" name="ContributedOn" type="date"
                       value="@(Model.ContributedOn?.ToString("yyyy-MM-dd"))" />
                <span asp-validation-for="ContributedOn" class="member-field-error"></span>
            </div>
            <div class="member-field">
                <label class="member-label" for="Note">Note (optional)</label>
                <input id="Note" name="Note" type="text" maxlength="200" value="@Model.Note" />
                <span asp-validation-for="Note" class="member-field-error"></span>
            </div>
            <div class="member-form-actions">
                <button class="member-btn" type="submit">Save contribution</button>
                <a class="member-btn member-btn-secondary" href="@Url.Action("Index")">Cancel</a>
            </div>
        </form>
    </div>
</section>
