@model PersonalFinance.AdminMvc.ViewModels.MemberSavingsGoalIndexViewModel
@{
    ViewData["Title"] = "Savings goals";
    Layout = "_MemberLayout";
    var invariant = System.Globalization.CultureInfo.InvariantCulture;
}
<section class="member-dashboard">
    <header class="member-dashboard-head plan-heading"><div class="member-dashboard-title"><p class="owli-greeting">@PersonalFinance.AdminMvc.Services.BudgetPlanSummary.PhilippineToday.ToString("MMMM yyyy", invariant)</p><h1 class="owli-screen-title">Plan</h1></div></header>
    <partial name="_PlanNavigation" />

    @if (Model.Error is not null)
    {
        <p class="notice login-notice" role="alert">@Model.Error</p>
    }
    @if (Model.Notice is not null)
    {
        <p class="notice login-notice" role="status">@Model.Notice</p>
    }

    <section class="member-card member-plan-card member-table-wrap" aria-label="Savings goal progress">
        <div class="member-section-heading"><a class="member-btn member-btn-small" href="@Url.Action("Create")">+ New goal</a>
            <div><h2 class="member-card-title">Your goals</h2><p class="owli-caption">Track contributions against each target.</p></div>
        </div>
        @if (Model.Results is null)
        {
            <p class="member-empty">Savings goals could not be loaded. Refresh this page to try again.</p>
        }
        else if (Model.Results.Items.Count == 0)
        {
            <p class="member-empty">No savings goals yet. Create one to start tracking.</p>
        }
        else
        {
            var results = Model.Results;
            <div class="member-goal-grid">
                @foreach (var goal in results.Items)
                {
                    var progress = Math.Clamp(goal.ProgressPercentage, 0m, 100m);
                    <article class="member-goal-card">
                        <header><span class="member-goal-mark" aria-hidden="true"><partial name="_NavIcon" model='"goal"' /></span><span class="member-pill @(goal.Status == "Active" ? "member-pill-income" : "member-pill-neutral")">@goal.Status</span></header>
                        <a class="member-goal-name" href="@Url.Action("Details", new { id = goal.GoalId })">@goal.Name</a>
                        <div class="member-goal-amount"><strong>@goal.SavedAmount.ToString("N2", invariant)</strong><span>of @goal.TargetAmount.ToString("N2", invariant) @goal.BaseCurrency</span></div>
                        <div class="member-goal-progress" role="progressbar" aria-label="@goal.Name progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@progress.ToString("0.#", invariant)"><svg viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true"><rect class="member-progress-fill" width="@progress.ToString("0.#", invariant)" height="10" rx="5" /></svg></div>
                        <p class="owli-caption">@Math.Max(0m, goal.TargetAmount - goal.SavedAmount).ToString("N2", invariant) @goal.BaseCurrency remaining · @progress.ToString("0.#", invariant)%</p>
                        <footer class="member-goal-actions">
                            <a class="member-row-link" href="@Url.Action("Details", new { id = goal.GoalId })">Details</a>
                            @if (goal.Status == "Active")
                            {
                                <a class="member-btn member-btn-small" href="@Url.Action("Contribute", new { id = goal.GoalId })">Contribute</a>
                                <a class="member-row-link" href="@Url.Action("Edit", new { id = goal.GoalId })">Edit</a>
                                <a class="member-row-link member-row-danger" href="@Url.Action("Cancel", new { id = goal.GoalId })">Cancel</a>
                            }
                            <a class="member-row-link member-row-danger" href="@Url.Action("Delete", new { id = goal.GoalId })">Delete</a>
                        </footer>
                    </article>
                }
            </div>
            @if (results.Page * results.PageSize < results.TotalCount)
            {
                <nav class="member-pager" aria-label="Goal pages">
                    <a class="member-btn" href="@Url.Action("Index", new { Page = results.Page + 1 })">Next</a>
                    <span class="owli-caption">Page @results.Page · @results.TotalCount goals</span>
                </nav>
            }
        }
    </section>
</section>
