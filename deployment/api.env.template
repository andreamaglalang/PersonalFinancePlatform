# OWLI API: placeholders only; inject per process through the hosting secret store.
ASPNETCORE_ENVIRONMENT=Production
AllowedHosts=api.owli.example
# The finance database: the same catalog the worker uses (worker.env.template). Rename both together if needed.
ConnectionStrings__DefaultConnection=Server=tcp:SQL_HOST,1433;Database=PersonalFinanceDb;User ID=OWLI_RUNTIME;Password=REPLACE_FROM_SECRET_STORE;Encrypt=True;TrustServerCertificate=False
Jwt__Issuer=OWLI.Api
Jwt__Audience=OWLI.Clients
Jwt__SigningKeyBase64=REPLACE_WITH_BASE64_OF_AT_LEAST_32_RANDOM_BYTES
CurrencyPolicy__MaximumRateAgeDays=7
# Direct Kestrel TLS option only; IIS manages its own bindings.
# ASPNETCORE_URLS=https://127.0.0.1:8443
# Kestrel__Certificates__Default__Path=/secure/owli-api.pfx
# Kestrel__Certificates__Default__Password=REPLACE_FROM_SECRET_STORE

# Mandatory deployment safety setting: workers/storage must remain disabled.
Hangfire__Enabled=false
# OWLI_DEV_CERT_THUMBPRINT must remain UNSET in deployment.
