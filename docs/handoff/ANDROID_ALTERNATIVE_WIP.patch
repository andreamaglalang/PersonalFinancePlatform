+/** Strict wire mapping for api/recurring-bills. Decimals never pass through Double. */
+internal object RecurringBillJson {
+    /** CreateRecurringBillRequest: exactly the creation fields; the API rejects unknown fields. */
+    fun create(name: String, categoryId: Int, amount: BigDecimal, currencyCode: String,
+        reminderDaysBefore: Int, isActive: Boolean, frequency: BillFrequency, firstDueDate: LocalDate): String =
+        write {
+            name("name").value(name)
+            name("categoryId").value(categoryId)
+            name("amount").value(amount)
+            name("currencyCode").value(currencyCode)
+            name("reminderDaysBefore").value(reminderDaysBefore)
+            name("isActive").value(isActive)
+            name("frequency").value(frequency.name)
+            name("firstDueDate").value(firstDueDate.toString())
+        }
+
+    /** UpdateRecurringBillRequest: the editable fields only; frequency and first due date are fixed. */
+    fun update(name: String, categoryId: Int, amount: BigDecimal, currencyCode: String,
+        reminderDaysBefore: Int, isActive: Boolean): String = write {
+        name("name").value(name)
+        name("categoryId").value(categoryId)
+        name("amount").value(amount)
+        name("currencyCode").value(currencyCode)
+        name("reminderDaysBefore").value(reminderDaysBefore)
+        name("isActive").value(isActive)
+    }
+
+    /** PayBillRequest: exactly clientId and dueDate. */
+    fun pay(dueDate: LocalDate, clientId: UUID): String = write {
+        name("clientId").value(clientId.toString())
+        name("dueDate").value(dueDate.toString())
+    }
+
+    fun billPage(body: String, page: Int, size: Int): RecurringBillPage {
+        val root = root(body)
+        val items = root.field("items").asJsonArray
+        val total = root.number("totalCount").longValueExact()
+        require(root.int("page") == page && root.int("pageSize") == size)
+        require(total >= 0 && items.size() <= size && items.size().toLong() <= total)
+        val bills = items.map { it.asJsonObject.toBill() }
+        require(bills.map { it.billId }.distinct().size == bills.size)
+        return RecurringBillPage(bills, page, size, total)
+    }
+
+    fun bill(body: String): RecurringBill = root(body).toBill()
+
+    /**
+     * The payment receipt proves the bill was paid. The controller projects the receipt without the owner's user id,
+     * so only the fields the API actually returns are required.
+     */
+    fun paymentReceipt(body: String): Unit {
+        val root = root(body)
+        val receipt = root.field("receipt").asJsonObject
+        require(receipt.int("billId") > 0 && receipt.int("transactionId") > 0)
+        require(receipt.number("amount").signum() > 0)
+        require(receipt.number("fxRate").signum() > 0)
+        require(receipt.number("amountBase").signum() >= 0)
+        require(receipt.text("baseCurrency").matches(Regex("[A-Z]{3}")))
+        require(receipt.text("currencyCode").matches(Regex("[A-Z]{3}")))
+        return Unit
+    }
+
+    private fun JsonObject.toBill(): RecurringBill {
+        val amount = money("amount").also { require(it.signum() > 0) }
+        val frequency = BillFrequency.entries.firstOrNull { it.name == text("frequency") } ?: error("Invalid frequency")
+        val currency = text("currencyCode").also { require(it.matches(Regex("[A-Z]{3}"))) }
+        val reminder = int("reminderDaysBefore").also { require(it in 0..30) }
+        val first = date("firstDueDate")
+        val next = date("nextDueDate")
+        require(!next.isBefore(first)) { "Next due date precedes the first due date" }
+        return RecurringBill(int("billId").also { require(it > 0) }, text("name").also { require(it.isNotBlank()) },
+            int("categoryId").also { require(it > 0) }, text("categoryName").also { require(it.isNotBlank()) },
+            amount, currency, frequency, first, next, reminder, bool("isActive"))
+    }
+
+    private fun root(body: String): JsonObject {
+        val reader = JsonReader(StringReader(body)).apply { strictness = Strictness.STRICT }
+        val value = JsonParser.parseReader(reader)
+        require(reader.peek() == JsonToken.END_DOCUMENT)
+        return value.asJsonObject
+    }
+
+    private fun JsonObject.field(key: String) = get(key) ?: error("Invalid response")
+    private fun JsonObject.text(key: String): String {
+        val value = field(key)
+        require(value.isJsonPrimitive && value.asJsonPrimitive.isString)
+        return value.asString
+    }
+    private fun JsonObject.number(key: String): BigDecimal {
+        val value = field(key)
+        require(value.isJsonPrimitive && value.asJsonPrimitive.isNumber)
+        return value.asBigDecimal
+    }
+    private fun JsonObject.int(key: String) = number(key).intValueExact()
+    private fun JsonObject.bool(key: String): Boolean {
+        val value = field(key)
+        require(value.isJsonPrimitive && value.asJsonPrimitive.isBoolean)
+        return value.asBoolean
+    }
+    private fun JsonObject.date(key: String): LocalDate {
+        val raw = text(key)
+        require(raw.matches(Regex("[0-9]{4}-[0-9]{2}-[0-9]{2}")))
+        return LocalDate.parse(raw).also { require(it.year in 1..9999) }
+    }
+    private fun JsonObject.money(key: String): BigDecimal = number(key).also {
+        require(it.signum() >= 0 && it <= BigDecimal("9999999999999999.99"))
+        it.setScale(2, java.math.RoundingMode.UNNECESSARY)
+    }
+
+    private fun write(block: JsonWriter.() -> Unit): String {
+        val out = StringWriter()
+        JsonWriter(out).use { it.beginObject(); it.block(); it.endObject() }
+        return out.toString().also { require(it.toByteArray(Charsets.UTF_8).size <= MAX_CATEGORY_REQUEST_BYTES) }
+    }
+}
+
+/** Existing api/recurring-bills endpoints only. Every write is online; bills have no offline queue. */
+internal class RemoteRecurringBillRepository(
+    private val transport: AuthenticatedFinanceTransport,
+    private val configuration: ApiConfiguration,
+    auth: InMemoryAuthRepository,
+    engine: FinanceWriteEngine,
+) : RecurringBillRepository {
+    private val writer = FinanceWriter(auth, engine)
+
+    override suspend fun list(includeInactive: Boolean, page: Int, pageSize: Int): FinanceResult<RecurringBillPage> {
+        if (page < 1 || pageSize < 1) return FinanceResult.Failure(FinanceFailure.InvalidInput)
+        return transport.get(FinanceResource.RecurringBills,
+            queryString("includeInactive" to includeInactive, "page" to page, "pageSize" to pageSize)) {
+            RecurringBillJson.billPage(it, page, pageSize)
+        }
+    }
+
+    override suspend fun create(name: String, categoryId: Int, amount: BigDecimal, currencyCode: String,
+        reminderDaysBefore: Int, isActive: Boolean, frequency: BillFrequency,
+        firstDueDate: LocalDate): FinanceResult<RecurringBill> {
+        val draft = RecurringBillDraft(name, categoryId, amount, currencyCode, reminderDaysBefore, isActive,
+            frequency, firstDueDate)
+        if (!draft.valid) return FinanceResult.Failure(FinanceFailure.InvalidInput)
+        return try {
+            writer.send(method = WriteMethod.POST, url = configuration.recurringBillUrl(null),
+                body = RecurringBillJson.create(draft.name, draft.categoryId, draft.amount, draft.currencyCode,
+                    draft.reminderDaysBefore, draft.isActive, draft.frequency, draft.firstDueDate),
+                ok = setOf(201, 200),
+                decode = { RecurringBillJson.bill(it).also { bill ->
+                    require(bill.name == draft.name && bill.categoryId == draft.categoryId
+                        && bill.amount.compareTo(draft.amount) == 0 && bill.firstDueDate == draft.firstDueDate)
+                } })
+        } catch (_: IllegalArgumentException) {
+            FinanceResult.Failure(FinanceFailure.InvalidInput)
+        }
+    }
+
+    override suspend fun update(billId: Int, name: String, categoryId: Int, amount: BigDecimal, currencyCode: String,
+        reminderDaysBefore: Int, isActive: Boolean): FinanceResult<RecurringBill> {
+        if (billId <= 0) return FinanceResult.Failure(FinanceFailure.InvalidInput)
+        val draft = RecurringBillDraft(name, categoryId, amount, currencyCode, reminderDaysBefore, isActive,
+            BillFrequency.Monthly, LocalDate.of(2000, 1, 1))
+        if (!draft.valid) return FinanceResult.Failure(FinanceFailure.InvalidInput)
+        return try {
+            writer.send(method = WriteMethod.PUT, url = configuration.recurringBillUrl(billId),
+                body = RecurringBillJson.update(draft.name, draft.categoryId, draft.amount, draft.currencyCode,
+                    draft.reminderDaysBefore, draft.isActive),
+                ok = setOf(200),
+                decode = { RecurringBillJson.bill(it).also { bill -> require(bill.billId == billId) } })
+        } catch (_: IllegalArgumentException) {
+            FinanceResult.Failure(FinanceFailure.InvalidInput)
+        }
+    }
+
+    override suspend fun delete(billId: Int): FinanceResult<Unit> {
+        if (billId <= 0) return FinanceResult.Failure(FinanceFailure.InvalidInput)
+        return writer.send(method = WriteMethod.DELETE, url = configuration.recurringBillUrl(billId), body = null,
+            ok = setOf(204, 200)) { }
+    }
+
+    override suspend fun pay(billId: Int, dueDate: LocalDate, clientId: UUID): FinanceResult<Unit> {
+        if (billId <= 0) return FinanceResult.Failure(FinanceFailure.InvalidInput)
+        return try {
+            writer.send(method = WriteMethod.POST, url = configuration.recurringBillPaymentUrl(billId),
+                body = RecurringBillJson.pay(dueDate, clientId),
+                // 201 paid, 200 replayed from a retained receipt: both mean the bill is paid.
+                ok = setOf(201, 200), decode = { RecurringBillJson.paymentReceipt(it) })
+        } catch (_: IllegalArgumentException) {
+            FinanceResult.Failure(FinanceFailure.InvalidInput)
+        }
+    }
+
+    /** Shared validation for the create and update drafts. */
+    private data class RecurringBillDraft(val name: String, val categoryId: Int, val amount: BigDecimal,
+        val currencyCode: String, val reminderDaysBefore: Int, val isActive: Boolean,
+        val frequency: BillFrequency, val firstDueDate: LocalDate) {
+        val valid: Boolean
+            get() = name.isNotBlank() && name.length <= 100 && categoryId > 0 && validBudgetLimit(amount)
+                && currencyCode.matches(Regex("[A-Z]{3}")) && reminderDaysBefore in 0..30
+                && firstDueDate.year in 1..9999
+    }
+}
diff --git a/android/app/src/main/java/com/elect3/mobdev/personalfinance/data/remote/SavingsGoalTransport.kt b/android/app/src/main/java/com/elect3/mobdev/personalfinance/data/remote/SavingsGoalTransport.kt
