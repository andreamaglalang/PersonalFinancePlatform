+package com.elect3.mobdev.personalfinance.data.remote
+
+import com.elect3.mobdev.personalfinance.data.auth.InMemoryAuthRepository
+import com.elect3.mobdev.personalfinance.domain.repository.FinanceFailure
+import com.elect3.mobdev.personalfinance.domain.repository.FinanceResult
+import com.elect3.mobdev.personalfinance.domain.repository.SavingsGoal
+import com.elect3.mobdev.personalfinance.domain.repository.SavingsGoalPage
+import com.elect3.mobdev.personalfinance.domain.repository.SavingsGoalRepository
+import com.elect3.mobdev.personalfinance.domain.repository.SavingsGoalStatus
+import com.elect3.mobdev.personalfinance.domain.repository.validBudgetLimit
+import com.google.gson.JsonObject
+import com.google.gson.JsonParser
+import com.google.gson.Strictness
+import com.google.gson.stream.JsonReader
+import com.google.gson.stream.JsonToken
+import com.google.gson.stream.JsonWriter
+import java.io.StringReader
+import java.io.StringWriter
+import java.math.BigDecimal
+import java.time.LocalDate
+import java.util.UUID
+
+/**
+ * Strict wire mapping for api/savings-goals. Decimals never pass through Double and every field the server computes
+ * is cross-checked against the others, so a contradictory response is rejected rather than displayed.
+ */
+internal object SavingsGoalJson {
+    /** CreateSavingsGoalRequest: exactly name, targetAmount and targetDate (the API rejects unknown fields). */
+    fun create(name: String, targetAmount: BigDecimal, targetDate: LocalDate?): String = write {
+        name("name").value(name)
+        name("targetAmount").value(targetAmount)
+        name("targetDate")
+        if (targetDate != null) value(targetDate.toString()) else nullValue()
+    }
+
+    /** CreateGoalContributionRequest: exactly clientId, amount, contributedOn and note (null when absent). */
+    fun contribute(amount: BigDecimal, contributedOn: LocalDate, note: String?, clientId: UUID): String = write {
+        name("clientId").value(clientId.toString())
+        name("amount").value(amount)
+        name("contributedOn").value(contributedOn.toString())
+        name("note")
+        if (note.isNullOrBlank()) nullValue() else value(note)
+    }
+
+    fun goalPage(body: String, page: Int, size: Int): SavingsGoalPage {
+        val root = root(body)
+        val items = root.field("items").asJsonArray
+        val total = root.number("totalCount").longValueExact()
+        require(root.int("page") == page && root.int("pageSize") == size)
+        require(total >= 0 && items.size() <= size && items.size().toLong() <= total)
+        val goals = items.map { it.asJsonObject.toGoal() }
+        require(goals.map { it.goalId }.distinct().size == goals.size)
+        return SavingsGoalPage(goals, page, size, total)
+    }
+
+    /** Single SavingsGoalResponse. */
+    fun goal(body: String): SavingsGoal = root(body).toGoal()
+
+    /**
+     * ContributionCreateResponse. Only the parent goal is needed by the UI; the receipt is validated enough to prove
+     * the server applied (or replayed) this contribution rather than ignoring it.
+     */
+    fun contributionResult(body: String, goalId: Int): SavingsGoal {
+        val root = root(body)
+        val receipt = root.field("receipt").asJsonObject
+        require(receipt.int("goalId") == goalId)
+        require(receipt.clientId() == root.field("receipt").asJsonObject.clientId())
+        return root.field("goal").asJsonObject.toGoal().also { require(it.goalId == goalId) }
+    }
+
+    private fun JsonObject.clientId(): UUID = UUID.fromString(text("clientId"))
+
+    private fun JsonObject.toGoal(): SavingsGoal {
+        val target = money("targetAmount").also { require(it.signum() > 0) }
+        val saved = money("savedAmount")
+        val remaining = money("remainingAmount")
+        // Surplus is negative until the goal is met, so it is validated as a signed amount, never as money.
+        val surplus = signedMoney("surplusAmount")
+        // The server defines remaining as target minus saved and surplus as the amount past the target.
+        require(remaining.compareTo(target.subtract(saved)) == 0)
+        require(surplus.compareTo(saved.subtract(target)) == 0)
+        val progress = number("progressPercentage")
+        require(progress.signum() >= 0)
+        val status = SavingsGoalStatus.entries.firstOrNull { it.name == text("status") } ?: error("Invalid status")
+        val currency = text("baseCurrency").also { require(it.matches(Regex("[A-Z]{3}"))) }
+        val version = text("version").also {
+            require(it.length == 12) { "Invalid row version" }
+        }
+        return SavingsGoal(int("goalId").also { require(it > 0) }, text("name").also { require(it.isNotBlank()) },
+            target, if (field("targetDate").isJsonNull) null else date("targetDate"), status,
+            saved, remaining, surplus, progress, currency, version)
+    }
+
+    private fun root(body: String): JsonObject {
+        val reader = JsonReader(StringReader(body)).apply { strictness = Strictness.STRICT }
+        val value = JsonParser.parseReader(reader)
+        require(reader.peek() == JsonToken.END_DOCUMENT)
+        return value.asJsonObject
+    }
+
+    private fun JsonObject.field(key: String) = get(key) ?: error("Invalid response")
+    private fun JsonObject.text(key: String): String {
+        val value = field(key)
+        require(value.isJsonPrimitive && value.asJsonPrimitive.isString)
+        return value.asString
+    }
+    private fun JsonObject.number(key: String): BigDecimal {
+        val value = field(key)
+        require(value.isJsonPrimitive && value.asJsonPrimitive.isNumber)
+        return value.asBigDecimal
+    }
+    private fun JsonObject.int(key: String) = number(key).intValueExact()
+    private fun JsonObject.date(key: String): LocalDate {
+        val raw = text(key)
+        require(raw.matches(Regex("[0-9]{4}-[0-9]{2}-[0-9]{2}")))
+        return LocalDate.parse(raw).also { require(it.year in 1..9999) }
+    }
+    private fun JsonObject.money(key: String): BigDecimal = number(key).also {
+        require(it.signum() >= 0 && it <= BigDecimal("9999999999999999.99"))
+        it.setScale(2, java.math.RoundingMode.UNNECESSARY)
+    }
+    private fun JsonObject.signedMoney(key: String): BigDecimal = number(key).also {
+        require(it.abs() <= BigDecimal("9999999999999999.99"))
+        it.setScale(2, java.math.RoundingMode.UNNECESSARY)
+    }
+
+    private fun write(block: JsonWriter.() -> Unit): String {
+        val out = StringWriter()
+        JsonWriter(out).use { it.beginObject(); it.block(); it.endObject() }
+        return out.toString().also { require(it.toByteArray(Charsets.UTF_8).size <= MAX_CATEGORY_REQUEST_BYTES) }
+    }
+}
+
+/**
+ * Existing api/savings-goals endpoints only. [cancel] sends the goal's current row version as a strong If-Match tag,
+ * which is the API's concurrency precondition: a stale version is rejected instead of silently overwriting.
+ */
+internal class RemoteSavingsGoalRepository(
+    private val transport: AuthenticatedFinanceTransport,
+    private val configuration: ApiConfiguration,
+    auth: InMemoryAuthRepository,
+    engine: FinanceWriteEngine,
+) : SavingsGoalRepository {
+    private val writer = FinanceWriter(auth, engine)
+
+    override suspend fun list(status: SavingsGoalStatus?, page: Int, pageSize: Int): FinanceResult<SavingsGoalPage> {
+        if (page < 1 || pageSize < 1) return FinanceResult.Failure(FinanceFailure.InvalidInput)
+        return transport.get(FinanceResource.SavingsGoals,
+            queryString("status" to status?.name, "page" to page, "pageSize" to pageSize)) {
+            SavingsGoalJson.goalPage(it, page, pageSize)
+        }
+    }
+
+    override suspend fun create(name: String, targetAmount: BigDecimal, targetDate: LocalDate?): FinanceResult<SavingsGoal> {
+        val trimmed = name.trim()
+        if (trimmed.isEmpty() || trimmed.length > 100) return FinanceResult.Failure(FinanceFailure.InvalidInput)
+        if (!validBudgetLimit(targetAmount)) return FinanceResult.Failure(FinanceFailure.InvalidInput)
+        return try {
+            writer.send(method = WriteMethod.POST, url = configuration.savingsGoalUrl(null),
+                body = SavingsGoalJson.create(trimmed, targetAmount, targetDate), ok = setOf(201, 200),
+                decode = { SavingsGoalJson.goal(it).also { goal ->
+                    require(goal.name == trimmed && goal.targetAmount.compareTo(targetAmount) == 0)
+                } })
+        } catch (_: IllegalArgumentException) {
+            FinanceResult.Failure(FinanceFailure.InvalidInput)
+        }
+    }
+
+    override suspend fun contribute(goalId: Int, amount: BigDecimal, contributedOn: LocalDate, note: String?,
+        clientId: UUID): FinanceResult<SavingsGoal> {
+        if (goalId <= 0) return FinanceResult.Failure(FinanceFailure.InvalidInput)
+        if (!validBudgetLimit(amount)) return FinanceResult.Failure(FinanceFailure.InvalidInput)
+        return try {
+            writer.send(method = WriteMethod.POST, url = configuration.savingsGoalContributionUrl(goalId, null),
+                body = SavingsGoalJson.contribute(amount, contributedOn, note?.trim()?.take(200), clientId),
+                // 201 created, 200 replayed from a retained receipt: both mean the contribution is recorded.
+                ok = setOf(201, 200),
+                decode = { SavingsGoalJson.contributionResult(it, goalId) })
+        } catch (_: IllegalArgumentException) {
+            FinanceResult.Failure(FinanceFailure.InvalidInput)
+        }
+    }
+
+    override suspend fun cancel(goalId: Int, version: String): FinanceResult<SavingsGoal> {
+        if (goalId <= 0) return FinanceResult.Failure(FinanceFailure.InvalidInput)
+        // The API requires exactly one strong quoted tag; anything else is a client error, never a blind retry.
+        if (version.length != 12) return FinanceResult.Failure(FinanceFailure.InvalidInput)
+        return writer.send(method = WriteMethod.POST, url = configuration.savingsGoalCancelUrl(goalId), body = null,
+            ok = setOf(200), headers = mapOf("If-Match" to "\"$version\""),
+            decode = { SavingsGoalJson.goal(it).also { goal ->
+                require(goal.goalId == goalId && goal.status == SavingsGoalStatus.Cancelled)
+            } })
+    }
+}
