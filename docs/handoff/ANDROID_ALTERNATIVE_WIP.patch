+                    singleLine = true, modifier = Modifier.fillMaxWidth())
+                OutlinedTextField(target, { target = it }, label = { Text(stringResource(R.string.savings_goal_target)) },
+                    singleLine = true, keyboardOptions = decimalKeyboard, modifier = Modifier.fillMaxWidth())
+                Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.spacedBy(10.dp)) {
+                    TextButton(onClick = { creating = false }) { Text(stringResource(R.string.savings_goal_cancel)) }
+                    TextButton(onClick = { onCreate(name, target.toBigDecimalOrNull()) },
+                        enabled = state.canWrite) { Text(stringResource(R.string.savings_goal_save)) }
+                }
+            }
+        }
+
+        when {
+            state.goals.isEmpty() && state.loaded ->
+                Text(stringResource(R.string.savings_goals_empty), style = typography.caption,
+                    color = scheme.onSurfaceVariant, textAlign = TextAlign.Center, modifier = Modifier.fillMaxWidth().padding(vertical = 18.dp))
+            else -> state.goals.forEach { goal ->
+                Column(Modifier.fillMaxWidth().clip(RoundedCornerShape(20.dp)).border(1.dp, owli.hairline, RoundedCornerShape(20.dp))
+                    .padding(16.dp), verticalArrangement = Arrangement.spacedBy(6.dp)) {
+                    Row(Modifier.fillMaxWidth(), verticalAlignment = Alignment.CenterVertically) {
+                        Column(Modifier.weight(1f)) {
+                            Text(goal.name, style = typography.bodyStrong)
+                            Text(statusLabel(goal.status), style = typography.caption, color = scheme.onSurfaceVariant)
+                        }
+                        Text("${goal.savedAmount} / ${goal.targetAmount} ${goal.baseCurrency}", style = typography.label)
+                    }
+                    Box(Modifier.fillMaxWidth().height(8.dp).clip(CircleShape).background(owli.field)) {
+                        val fraction = goal.progressPercentage.divide(BigDecimal(100)).toFloat().coerceIn(0f, 1f)
+                        Box(Modifier.fillMaxWidth(fraction).height(8.dp).clip(CircleShape).background(owli.accent))
+                    }
+                    Text(stringResource(R.string.savings_goal_saved_of, goal.savedAmount.toString(), goal.targetAmount.toString()),
+                        style = typography.caption, color = scheme.onSurfaceVariant)
+                    Row(horizontalArrangement = Arrangement.spacedBy(10.dp)) {
+                        TextButton(onClick = { contributionGoal = if (contributionGoal == goal.goalId) null else goal.goalId },
+                            enabled = state.canWrite && goal.status == SavingsGoalStatus.Active) {
+                            Text(stringResource(R.string.savings_goal_contribute))
+                        }
+                        TextButton(onClick = { cancelGoal = goal }, enabled = state.canWrite
+                            && goal.status == SavingsGoalStatus.Active) {
+                            Text(stringResource(R.string.savings_goal_cancel))
+                        }
+                    }
+                    if (contributionGoal == goal.goalId) {
+                        Column(verticalArrangement = Arrangement.spacedBy(10.dp)) {
+                            OutlinedTextField(contribution, { contribution = it },
+                                label = { Text(stringResource(R.string.savings_goal_amount)) }, singleLine = true,
+                                keyboardOptions = decimalKeyboard, modifier = Modifier.fillMaxWidth())
+                            OutlinedTextField(note, { note = it },
+                                label = { Text(stringResource(R.string.savings_goal_note)) }, singleLine = true,
+                                modifier = Modifier.fillMaxWidth())
+                            TextButton(onClick = {
+                                onContribute(goal.goalId, contribution.toBigDecimalOrNull(), LocalDate.now(), note)
+                            }, enabled = state.canWrite) { Text(stringResource(R.string.savings_goal_contribute)) }
+                        }
+                    }
+                }
+            }
+        }
+
+        state.formError?.let { error ->
+            Text(errorMessage(error), style = typography.caption, color = MaterialTheme.colorScheme.error,
+                modifier = Modifier.fillMaxWidth())
+        }
+        state.staleReason?.let {
+            Text(stringResource(R.string.savings_goal_error_stale), style = typography.caption,
+                color = scheme.onSurfaceVariant, modifier = Modifier.fillMaxWidth())
+        }
+    }
+
+    cancelGoal?.let { goal ->
+        AlertDialog(onDismissRequest = { cancelGoal = null },
+            title = { Text(stringResource(R.string.savings_goal_cancel)) },
+            text = { Text(stringResource(R.string.savings_goal_cancel_confirm)) },
+            confirmButton = { TextButton(onClick = { onCancel(goal); cancelGoal = null }) {
+                Text(stringResource(R.string.savings_goal_cancel)) } },
+            dismissButton = { TextButton(onClick = { cancelGoal = null }) { Text(stringResource(R.string.savings_goal_cancel)) } })
+    }
+}
+
+@Composable
+private fun statusLabel(status: SavingsGoalStatus): String = stringResource(when (status) {
+    SavingsGoalStatus.Active -> R.string.savings_goal_status_active
+    SavingsGoalStatus.Completed -> R.string.savings_goal_status_completed
+    SavingsGoalStatus.Cancelled -> R.string.savings_goal_status_cancelled
+})
+
+@Composable
+private fun errorMessage(error: SavingsGoalFormError): String = stringResource(when (error) {
+    SavingsGoalFormError.Name -> R.string.savings_goal_error_name
+    SavingsGoalFormError.Amount -> R.string.savings_goal_error_amount
+    SavingsGoalFormError.Stale -> R.string.savings_goal_error_stale
+    SavingsGoalFormError.NotFound, SavingsGoalFormError.Rejected, SavingsGoalFormError.Failed ->
+        R.string.savings_goal_error_failed
+})
+
+/** Runs [block] once per distinct [key]; keeps the section free of effect-loop restarts. */
+@Composable
+private fun LaunchedEffectUnit(key: Any?, block: suspend () -> Unit) {
+    androidx.compose.runtime.LaunchedEffect(key) { block() }
+}
