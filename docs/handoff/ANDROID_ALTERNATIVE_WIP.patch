+?package com.elect3.mobdev.personalfinance.ui.notifications
+
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import com.elect3.mobdev.personalfinance.domain.repository.FinanceFailure
+import com.elect3.mobdev.personalfinance.domain.repository.FinanceNotification
+import com.elect3.mobdev.personalfinance.domain.repository.FinanceResult
+import com.elect3.mobdev.personalfinance.domain.repository.NotificationRepository
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.launch
+
+ data class NotificationInboxState(
+    val loading: Boolean = false,
+    val notifications: List<FinanceNotification> = emptyList(),
+    val unreadOnly: Boolean = false,
+    val page: Int = 1,
+    val pageSize: Int = 20,
+    val totalCount: Long = 0,
+    val error: FinanceFailure? = null,
+    val hasLoaded: Boolean = false,
+    val sessionExpired: Boolean = false,
+    val invalidated: Boolean = false,
+) {
+    val isEmpty get() = hasLoaded && error == null && notifications.isEmpty()
+    val pageCount get() = ((totalCount + pageSize - 1) / pageSize).toInt().coerceAtLeast(1)
+    val canGoPrevious get() = !loading && !invalidated && page > 1
+    val canGoNext get() = !loading && !invalidated && page.toLong() * pageSize < totalCount
+}
+
+/** Read-only paged inbox. Opening Plan/Inbox triggers refresh from the screen. */
+class NotificationInboxViewModel(
+    private val repository: NotificationRepository,
+    private val isSessionCurrent: () -> Boolean = { true },
+    private val onSessionExpired: () -> Unit = {},
+) : ViewModel() {
+    private val mutable = MutableStateFlow(NotificationInboxState())
+    val state = mutable.asStateFlow()
+    private var load: Job? = null
+
+    fun refresh() {
+        val before = mutable.value
+        if (before.invalidated || before.loading) return
+        if (!isSessionCurrent()) { expire(); return }
+        mutable.value = before.copy(loading = true, error = null)
+        load = viewModelScope.launch {
+            val result = try { repository.list(before.unreadOnly, before.page, before.pageSize) }
+            catch (cancelled: CancellationException) { throw cancelled }
+            catch (_: Exception) { FinanceResult.Failure(FinanceFailure.Unavailable) }
+            if (!isSessionCurrent()) { expire(); return@launch }
+            when (result) {
+                is FinanceResult.Success -> mutable.value = mutable.value.copy(
+                    loading = false, error = null, notifications = result.value.items,
+                    page = result.value.page, pageSize = result.value.pageSize,
+                    totalCount = result.value.totalCount, hasLoaded = true,
+                )
+                is FinanceResult.Failure -> if (result.reason.isSessionFailure()) expire() else
+                    mutable.value = mutable.value.copy(loading = false, error = result.reason, hasLoaded = true)
+            }
+        }
+    }
+
+    fun setUnreadOnly(value: Boolean) {
+        if (mutable.value.invalidated || mutable.value.unreadOnly == value) return
+        load?.cancel()
+        mutable.value = mutable.value.copy(unreadOnly = value, page = 1, loading = false,
+            notifications = emptyList(), totalCount = 0, error = null, hasLoaded = false)
+        refresh()
+    }
+
+    fun previousPage() = moveTo(mutable.value.page - 1)
+    fun nextPage() = moveTo(mutable.value.page + 1)
+    private fun moveTo(page: Int) {
+        val current = mutable.value
+        if (page < 1 || page == current.page || current.invalidated || current.loading ||
+            (page - 1L) * current.pageSize >= current.totalCount) return
+        load?.cancel()
+        mutable.value = current.copy(page = page, loading = false, error = null, hasLoaded = false)
+        refresh()
+    }
+
+    private fun expire() {
+        val current = mutable.value
+        if (current.sessionExpired) return
+        mutable.value = current.copy(loading = false, notifications = emptyList(), error = null,
+            hasLoaded = false, sessionExpired = true, invalidated = true)
+        onSessionExpired()
+    }
+}
+
+private fun FinanceFailure.isSessionFailure() = this == FinanceFailure.SessionExpired || this == FinanceFailure.MissingSession
