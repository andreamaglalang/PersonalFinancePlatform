+package com.elect3.mobdev.personalfinance.data.remote
+
+import com.elect3.mobdev.personalfinance.domain.repository.FinanceFailure
+import com.elect3.mobdev.personalfinance.domain.repository.FinanceNotification
+import com.elect3.mobdev.personalfinance.domain.repository.FinanceResult
+import com.elect3.mobdev.personalfinance.domain.repository.NotificationPage
+import com.elect3.mobdev.personalfinance.domain.repository.NotificationRepository
+import com.google.gson.JsonObject
+import com.google.gson.JsonParser
+import com.google.gson.Strictness
+import com.google.gson.stream.JsonReader
+import com.google.gson.stream.JsonToken
+import java.io.StringReader
+import java.time.Instant
+
+/** Strict response mapping for the owner-scoped, read-only api/notifications contract. */
+internal object NotificationJson {
+    fun page(body: String, unreadOnly: Boolean, requestedPage: Int, requestedSize: Int): NotificationPage {
+        val reader = JsonReader(StringReader(body)).apply { setStrictness(Strictness.STRICT) }
+        val root = JsonParser.parseReader(reader).asJsonObject
+        require(reader.peek() == JsonToken.END_DOCUMENT)
+        val page = root.int("page")
+        val size = root.int("pageSize")
+        val total = root.long("totalCount")
+        val items = root.array("items").map { it.asJsonObject.toNotification() }
+        require(page == requestedPage && size == requestedSize)
+        require(total >= 0 && items.size <= size && items.size.toLong() <= total)
+        require(items.map { it.notificationId }.distinct().size == items.size)
+        require(!unreadOnly || items.all { !it.isRead })
+        require(items.zipWithNext().all { (newer, older) ->
+            newer.createdAtUtc > older.createdAtUtc ||
+                (newer.createdAtUtc == older.createdAtUtc && newer.notificationId >= older.notificationId)
+        })
+        return NotificationPage(items, page, size, total)
+    }
+
+    private fun JsonObject.toNotification(): FinanceNotification {
+        val id = int("notificationId")
+        val type = text("type")
+        val message = text("message")
+        val isRead = primitive("isRead").asBoolean
+        val referenceType = optionalText("referenceType")
+        val referenceId = optionalInt("referenceId")
+        val created = Instant.parse(text("createdAtUtc"))
+        require(id > 0 && type.isNotBlank() && message.isNotBlank())
+        require(referenceType == null || referenceType.isNotBlank())
+        require(referenceId == null || referenceId > 0)
+        return FinanceNotification(id, type, referenceType, referenceId, message, isRead, created)
+    }
+
+    private fun JsonObject.field(name: String) =
+        get(name)?.takeUnless { it.isJsonNull } ?: throw IllegalArgumentException("Missing notification field")
+    private fun JsonObject.primitive(name: String) = field(name).asJsonPrimitive
+    private fun JsonObject.text(name: String): String {
+        val value = primitive(name)
+        require(value.isString)
+        return value.asString
+    }
+    private fun JsonObject.optionalText(name: String): String? {
+        val value = get(name) ?: return null
+        if (value.isJsonNull) return null
+        require(value.asJsonPrimitive.isString)
+        return value.asString
+    }
+    private fun JsonObject.int(name: String) = primitive(name).asBigDecimal.intValueExact()
+    private fun JsonObject.long(name: String) = primitive(name).asBigDecimal.longValueExact()
+    private fun JsonObject.optionalInt(name: String): Int? {
+        val value = get(name) ?: return null
+        if (value.isJsonNull) return null
+        return value.asJsonPrimitive.asBigDecimal.intValueExact()
+    }
+    private fun JsonObject.array(name: String) = field(name).asJsonArray
+}
+
+/** Authenticated GET only; there is intentionally no mark-as-read call. */
+internal class RemoteNotificationRepository(
+    private val transport: AuthenticatedFinanceTransport,
+) : NotificationRepository {
+    override suspend fun list(unreadOnly: Boolean, page: Int, pageSize: Int): FinanceResult<NotificationPage> {
+        if (page < 1 || pageSize !in 1..100) return FinanceResult.Failure(FinanceFailure.InvalidInput)
+        return transport.get(
+            FinanceResource.Notifications,
+            queryString("UnreadOnly" to unreadOnly, "Page" to page, "PageSize" to pageSize),
+        ) { NotificationJson.page(it, unreadOnly, page, pageSize) }
+    }
+}
