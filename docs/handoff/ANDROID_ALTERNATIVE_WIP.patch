+/**
+ * Savings goals for the signed-in account. Every figure comes from the server response; the app never recomputes
+ * saved, remaining or progress. Writes are blocked while a reload has not succeeded, because goals have no offline
+ * queue � a mutation is never guessed.
+ */
+@Composable
+fun SavingsGoalsSection(
+    state: SavingsGoalsState,
+    onCreate: (String, BigDecimal?) -> Unit,
+    onContribute: (Int, BigDecimal?, LocalDate, String?) -> Unit,
+    onCancel: (SavingsGoal) -> Unit,
+    onClearError: () -> Unit,
+    onConsumeNotice: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    var creating by rememberSaveable { mutableStateOf(false) }
+    var name by rememberSaveable { mutableStateOf("") }
+    var target by rememberSaveable { mutableStateOf("") }
+    var contributionGoal by rememberSaveable { mutableStateOf<Int?>(null) }
+    var contribution by rememberSaveable { mutableStateOf("") }
+    var note by rememberSaveable { mutableStateOf("") }
+    var cancelGoal by remember { mutableStateOf<SavingsGoal?>(null) }
+
+    val typography = LocalOwliTypography.current
+    val scheme = MaterialTheme.colorScheme
+    val owli = LocalOwliColors.current
+
+    LaunchedEffectUnit(state.savedCount) {
+        if (state.savedCount > 0) { creating = false; contributionGoal = null; name = ""; target = ""; contribution = ""; note = "" }
+    }
+    LaunchedEffectUnit(state.formError) { if (state.formError != null) onClearError() }
+    LaunchedEffectUnit(state.notice) { if (state.notice != null) onConsumeNotice() }
+
+    Column(modifier.fillMaxWidth().padding(start = 20.dp, end = 20.dp, top = 16.dp),
+        verticalArrangement = Arrangement.spacedBy(12.dp)) {
+        Row(Modifier.fillMaxWidth(), verticalAlignment = Alignment.CenterVertically) {
+            Text(stringResource(R.string.savings_goals_title), style = typography.bodyStrong,
+                modifier = Modifier.weight(1f).semantics { heading() })
+            TextButton(onClick = { creating = !creating }) {
+                Text(stringResource(if (creating) R.string.savings_goal_cancel else R.string.savings_goal_new))
+            }
+        }
+
+        if (creating) {
+            Column(Modifier.fillMaxWidth().clip(RoundedCornerShape(20.dp)).border(1.dp, owli.hairline, RoundedCornerShape(20.dp))
+                .padding(16.dp), verticalArrangement = Arrangement.spacedBy(10.dp)) {
