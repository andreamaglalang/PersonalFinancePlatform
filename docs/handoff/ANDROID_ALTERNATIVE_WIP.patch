+import androidx.compose.ui.unit.dp
+import com.elect3.mobdev.personalfinance.R
+import com.elect3.mobdev.personalfinance.domain.repository.FinanceNotification
+import java.time.Instant
+import java.time.ZoneId
+import java.time.format.DateTimeFormatter
+import java.time.format.FormatStyle
+import java.util.Locale
+
+@Composable
+fun NotificationInboxScreen(
+    state: NotificationInboxState,
+    onUnreadOnlyChange: (Boolean) -> Unit,
+    onRefresh: () -> Unit,
+    onPreviousPage: () -> Unit,
+    onNextPage: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    Column(modifier.fillMaxWidth().padding(horizontal = 20.dp, vertical = 16.dp), verticalArrangement = Arrangement.spacedBy(12.dp)) {
+        Row(Modifier.fillMaxWidth(), verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.SpaceBetween) {
+            Text(stringResource(R.string.notifications_title), style = MaterialTheme.typography.titleLarge)
+            OutlinedButton(onClick = onRefresh, enabled = !state.loading && !state.invalidated) {
+                Text(stringResource(R.string.notifications_refresh))
+            }
+        }
+        Row(verticalAlignment = Alignment.CenterVertically) {
+            Checkbox(checked = state.unreadOnly, onCheckedChange = onUnreadOnlyChange, enabled = !state.loading && !state.invalidated)
+            Text(stringResource(R.string.notifications_unread_only))
+        }
+        when {
+            state.sessionExpired -> Text(stringResource(R.string.notifications_session_expired), color = MaterialTheme.colorScheme.error)
+            state.loading && !state.hasLoaded -> Column(Modifier.align(Alignment.CenterHorizontally), horizontalAlignment = Alignment.CenterHorizontally) {
+                CircularProgressIndicator()
+                Text(stringResource(R.string.notifications_loading))
+            }
+            state.error != null -> Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+                Text(stringResource(R.string.notifications_error), color = MaterialTheme.colorScheme.error)
+                Button(onClick = onRefresh, enabled = !state.invalidated) { Text(stringResource(R.string.notifications_retry)) }
+            }
+            state.isEmpty -> Text(stringResource(if (state.unreadOnly) R.string.notifications_unread_empty else R.string.notifications_empty))
+            else -> {
+                Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+                    state.notifications.forEach { notification -> NotificationCard(notification) }
+                }
+                Row(Modifier.fillMaxWidth(), verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.SpaceBetween) {
+                    OutlinedButton(onClick = onPreviousPage, enabled = state.canGoPrevious) { Text(stringResource(R.string.notifications_previous)) }
+                    Text(stringResource(R.string.notifications_page, state.page, state.pageCount))
+                    OutlinedButton(onClick = onNextPage, enabled = state.canGoNext) { Text(stringResource(R.string.notifications_next)) }
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun NotificationCard(notification: FinanceNotification) {
+    Card(Modifier.fillMaxWidth()) {
+        Column(Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(6.dp)) {
+            Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween, verticalAlignment = Alignment.CenterVertically) {
+                Text(notification.type, style = MaterialTheme.typography.titleMedium)
+                if (!notification.isRead) Text(stringResource(R.string.notifications_unread_badge), color = MaterialTheme.colorScheme.primary)
+            }
+            Text(notification.message, style = MaterialTheme.typography.bodyMedium)
+            Text(notificationTimestampText(notification.createdAtUtc, ZoneId.systemDefault(), Locale.getDefault()),
+                style = MaterialTheme.typography.bodySmall, color = MaterialTheme.colorScheme.onSurfaceVariant)
+        }
+    }
+}
+
+internal fun notificationTimestampText(instant: Instant, zone: ZoneId, locale: Locale): String =
+    DateTimeFormatter.ofLocalizedDateTime(FormatStyle.MEDIUM).withLocale(locale).withZone(zone).format(instant)
+
+
+
+
