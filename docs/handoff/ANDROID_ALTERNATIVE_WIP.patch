@@ -0,0 +1,87 @@
+package com.elect3.mobdev.personalfinance.data.local
+
+import android.content.SharedPreferences
+import com.elect3.mobdev.personalfinance.domain.currency.SupportedCurrencies
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+/**
+ * Currency choices that the API cannot store: the default transaction currency, whether history shows the original
+ * foreign amount, and whether a foreign-currency save must be reviewed against a live rate first.
+ *
+ * Semantics mirror the MVC member preferences: the account currency stays fixed (PHP), the default is one of the
+ * twelve supported currencies, and toggling either switch never rewrites transactions or stored rates.
+ */
+data class CurrencyPreferences(
+    val defaultCurrency: String,
+    val showOriginalAmounts: Boolean,
+    val reviewRateBeforeSaving: Boolean,
+) {
+    companion object {
+        /** Matches MVC: account currency default, original amounts shown, no review gate. */
+        val Defaults = CurrencyPreferences("PHP", showOriginalAmounts = true, reviewRateBeforeSaving = false)
+
+        /** Fails closed: an unsupported or malformed currency falls back to the account currency. */
+        fun normalise(code: String?): String =
+            code?.takeIf { SupportedCurrencies.isSupported(it) } ?: Defaults.defaultCurrency
+    }
+}
+
+/** Device-local currency preferences, scoped per account; never synced and never shared with Mock Demo. */
+interface CurrencyPreferenceStore {
+    val preferences: StateFlow<CurrencyPreferences>
+    fun set(value: CurrencyPreferences)
+}
+
+/** Mock Demo: memory only, cleared with the demo session. */
+class InMemoryCurrencyPreferenceStore : CurrencyPreferenceStore {
+    private val mutable = MutableStateFlow(CurrencyPreferences.Defaults)
+    override val preferences: StateFlow<CurrencyPreferences> = mutable.asStateFlow()
+    override fun set(value: CurrencyPreferences) { mutable.value = value }
+}
+
+/**
+ * Signed-in accounts: app-private SharedPreferences on THIS device only, prefixed by account ID so another account
+ * on the same phone never reads these choices. Holds no tokens and no financial data.
+ */
+class DeviceCurrencyPreferenceStore(
+    private val prefs: SharedPreferences,
+    accountId: Int,
+) : CurrencyPreferenceStore {
+    init { require(accountId > 0) }
+
+    private val key = "a$accountId.currency.v1"
+    private val mutable = MutableStateFlow(read())
+    override val preferences: StateFlow<CurrencyPreferences> = mutable.asStateFlow()
+
+    private fun read(): CurrencyPreferences = tryUnpack(prefs.getString(key, null), accountId) ?: CurrencyPreferences.Defaults
+
+    override fun set(value: CurrencyPreferences) {
+        val stored = value.copy(defaultCurrency = CurrencyPreferences.normalise(value.defaultCurrency))
+        prefs.edit().putString(key, pack(accountId, stored)).apply()
+        mutable.value = stored
+    }
+
+    companion object {
+        /** Takes over the pre-existing app-private file; the legacy entry uses a different key and is ignored. */
+        const val FILE = "owli_currency_preferences"
+        private const val VERSION = "v1"
+
+        /** Pure serialisation, kept separate so the round-trip is unit-testable without Android. */
+        fun pack(accountId: Int, value: CurrencyPreferences): String =
+            VERSION + "|" + accountId + "|" + CurrencyPreferences.normalise(value.defaultCurrency) + "|" +
+                (if (value.showOriginalAmounts) "1" else "0") + "|" + (if (value.reviewRateBeforeSaving) "1" else "0")
+
+        /**
+         * Restores preferences. Fails closed: a malformed payload, an unsupported currency or one written for another
+         * account yields null, so the caller falls back to defaults rather than another member's settings.
+         */
+        fun tryUnpack(raw: String?, accountId: Int): CurrencyPreferences? {
+            val parts = raw?.split('|') ?: return null
+            if (parts.size != 5 || parts[0] != VERSION || parts[1].toIntOrNull() != accountId) return null
+            val currency = parts[2].takeIf { SupportedCurrencies.isSupported(it) } ?: return null
+            return CurrencyPreferences(currency, parts[3] == "1", parts[4] == "1")
+        }
+    }
+}
