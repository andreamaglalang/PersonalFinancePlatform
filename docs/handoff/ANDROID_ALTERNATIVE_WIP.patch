+import kotlinx.coroutines.test.runTest
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class CategoryCacheWarmerTest {
+    private fun cat(id: Int, type: TransactionType = TransactionType.Expense) =
+        Category(id, "Synthetic $id", type, null, isActive = true, isSystemDefault = true)
+
+    @Test fun pagesUntilTheServerReportsTheActiveListIsComplete() = runTest {
+        val calls = mutableListOf<CategoryQuery>()
+        val repo = object : CategoryRepository {
+            override suspend fun list(query: CategoryQuery): FinanceResult<CategoryPage> {
+                calls += query
+                val items = if (query.page == 1) List(CategoryCacheWarmer.PageSize) { cat(it + 1) }
+                else List(50) { cat(CategoryCacheWarmer.PageSize + it + 1) }
+                return FinanceResult.Success(CategoryPage(items, query.page,
+                    CategoryCacheWarmer.PageSize, 150))
+            }
+        }
+        assertTrue(CategoryCacheWarmer.warm(repo))
+        // Two pages per type, Expense first then Income.
+        assertEquals(4, calls.size)
+        assertEquals(listOf(1, 2, 1, 2), calls.map { it.page })
+        assertEquals(listOf(TransactionType.Expense, TransactionType.Expense,
+            TransactionType.Income, TransactionType.Income), calls.map { it.type })
+        assertTrue(calls.all { !it.includeInactive })
+        assertTrue(calls.all { it.pageSize == CategoryCacheWarmer.PageSize })
+    }
+
+    @Test fun emptyFirstPageStopsInsteadOfAssumingCompleteness() = runTest {
+        val calls = mutableListOf<CategoryQuery>()
+        val repo = object : CategoryRepository {
+            override suspend fun list(query: CategoryQuery): FinanceResult<CategoryPage> {
+                calls += query
+                return FinanceResult.Success(CategoryPage(emptyList(), query.page,
+                    CategoryCacheWarmer.PageSize, 0))
+            }
+        }
+        CategoryCacheWarmer.warm(repo)
+        assertEquals(listOf(TransactionType.Expense, TransactionType.Income), calls.map { it.type })
+        assertTrue(calls.all { it.page == 1 })
+    }
+
+    @Test fun shortPageStopsRatherThanRequestingBeyondTheServersOwnContract() = runTest {
+        val calls = mutableListOf<CategoryQuery>()
+        val repo = object : CategoryRepository {
+            override suspend fun list(query: CategoryQuery): FinanceResult<CategoryPage> {
+                calls += query
+                val items = if (query.page == 1) List(CategoryCacheWarmer.PageSize) { cat(it + 1) }
+                else List(20) { cat(CategoryCacheWarmer.PageSize + it + 1) }
+                return FinanceResult.Success(CategoryPage(items, query.page,
+                    CategoryCacheWarmer.PageSize, 150))
+            }
+        }
+        CategoryCacheWarmer.warm(repo)
+        // Page 1 full (100 of 150), then page 2 short (20 < pageSize) -> stop instead of looping.
+        assertEquals(listOf(1, 2, 1, 2), calls.map { it.page })
+    }
+
+    @Test fun failureStopsThatTypeOnlyAndTheOtherTypeStillWarms() = runTest {
+        val calls = mutableListOf<CategoryQuery>()
+        val repo = object : CategoryRepository {
+            override suspend fun list(query: CategoryQuery): FinanceResult<CategoryPage> {
+                calls += query
+                if (query.type == TransactionType.Expense)
+                    return FinanceResult.Failure(FinanceFailure.Unavailable, isConnectivityFailure = true)
+                return FinanceResult.Success(CategoryPage(listOf(cat(9)), query.page,
+                    CategoryCacheWarmer.PageSize, 1))
+            }
+        }
+        CategoryCacheWarmer.warm(repo)
+        assertEquals(listOf(TransactionType.Expense, TransactionType.Income), calls.map { it.type })
+    }
+
+    @Test fun inactiveCategoriesAreNeverRequested() = runTest {
+        val calls = mutableListOf<CategoryQuery>()
+        val repo = object : CategoryRepository {
+            override suspend fun list(query: CategoryQuery): FinanceResult<CategoryPage> {
+                calls += query
+                return FinanceResult.Success(CategoryPage(listOf(cat(1)), query.page,
+                    CategoryCacheWarmer.PageSize, 1))
+            }
+        }
+        assertTrue(CategoryCacheWarmer.warm(repo))
+        assertTrue(calls.all { !it.includeInactive })
+    }
+
+    @Test fun typeFailureReportsFalseSoTheGuardCanRetry() = runTest {
+        val calls = mutableListOf<CategoryQuery>()
+        val repo = object : CategoryRepository {
+            override suspend fun list(query: CategoryQuery): FinanceResult<CategoryPage> {
+                calls += query
+                return FinanceResult.Failure(FinanceFailure.Unavailable, isConnectivityFailure = true)
+            }
+        }
+        assertFalse(CategoryCacheWarmer.warm(repo))
+        // Both types are attempted; Expense fails, Income still succeeds.
+        assertEquals(listOf(TransactionType.Expense, TransactionType.Income), calls.map { it.type })
+    }
+}
