@@ -0,0 +1,177 @@
+package com.elect3.mobdev.personalfinance.ui.savings
+
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import com.elect3.mobdev.personalfinance.domain.repository.FinanceFailure
+import com.elect3.mobdev.personalfinance.domain.repository.FinanceResult
+import com.elect3.mobdev.personalfinance.domain.repository.SavingsGoal
+import com.elect3.mobdev.personalfinance.domain.repository.SavingsGoalRepository
+import com.elect3.mobdev.personalfinance.domain.repository.validBudgetLimit
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.launch
+import java.math.BigDecimal
+import java.time.Clock
+import java.time.LocalDate
+import java.time.LocalDateTime
+import java.util.UUID
+
+enum class SavingsGoalFormError { Name, Amount, Stale, NotFound, Rejected, Failed }
+
+enum class SavingsGoalNotice { Created, Contributed, Cancelled }
+
+data class SavingsGoalsState(
+    val loading: Boolean = true,
+    val error: FinanceFailure? = null,
+    val goals: List<SavingsGoal> = emptyList(),
+    val saving: Boolean = false,
+    val formError: SavingsGoalFormError? = null,
+    /** Increments on each confirmed write so the UI can close its sheet. */
+    val savedCount: Int = 0,
+    val notice: SavingsGoalNotice? = null,
+    val invalidated: Boolean = false,
+    /**
+     * A reload failed while figures were already shown (offline, timeout, server error). They stay visible but
+     * read-only: savings goals have no offline queue, so nothing is written until a reload succeeds.
+     */
+    val staleReason: FinanceFailure? = null,
+    val loadedAt: LocalDateTime? = null,
+) {
+    val loaded get() = !loading && error == null
+    val stale get() = staleReason != null
+    val canWrite get() = loaded && !stale && !saving && !invalidated
+}
+
+/**
+ * Savings goals for the signed-in account, read and written only through api/savings-goals. There is deliberately no
+ * offline queue: a goal mutation is never guessed, so writes are blocked until a reload has succeeded.
+ */
+class SavingsGoalsViewModel(
+    private val goals: SavingsGoalRepository,
+    private val isSessionCurrent: () -> Boolean = { true },
+    private val onSessionExpired: () -> Unit = {},
+    private val clock: Clock = Clock.systemDefaultZone(),
+) : ViewModel() {
+    private val mutable = MutableStateFlow(SavingsGoalsState())
+    val state = mutable.asStateFlow()
+    private var load: Job? = null
+    private var write: Job? = null
+
+    init { refresh() }
+
+    fun refresh() {
+        if (mutable.value.invalidated) return
+        load?.cancel()
+        mutable.value = mutable.value.copy(loading = mutable.value.loadedAt == null, error = null)
+        load = viewModelScope.launch {
+            val result = safely { pageAll() }
+            if (!isSessionCurrent()) { expire(); return@launch }
+            when (result) {
+                is FinanceResult.Success -> mutable.value = mutable.value.copy(loading = false, error = null,
+                    staleReason = null, loadedAt = LocalDateTime.now(clock),
+                    goals = result.value.sortedWith(compareBy({ it.name.lowercase() }, { it.goalId })))
+                is FinanceResult.Failure -> {
+                    if (result.reason.isSession()) { expire(); return@launch }
+                    // Keep goals already shown (labelled stale) rather than replacing them with an error.
+                    mutable.value = if (mutable.value.loadedAt != null)
+                        mutable.value.copy(loading = false, staleReason = result.reason)
+                    else mutable.value.copy(loading = false, error = result.reason)
+                }
+            }
+        }
+    }
+
+    /** Every goal, all pages, bounded. */
+    private suspend fun pageAll(): FinanceResult<List<SavingsGoal>> {
+        val all = ArrayList<SavingsGoal>()
+        for (page in 1..MAX_PAGES) {
+            when (val r = safely { goals.list(null, page, PAGE_SIZE) }) {
+                is FinanceResult.Failure -> return r
+                is FinanceResult.Success -> {
+                    all += r.value.items
+                    if (r.value.items.isEmpty() || all.size.toLong() >= r.value.totalCount)
+                        return FinanceResult.Success(all.distinctBy { it.goalId })
+                }
+            }
+        }
+        return FinanceResult.Failure(FinanceFailure.InvalidResponse)
+    }
+
+    fun clearFormError() { mutable.value = mutable.value.copy(formError = null) }
+    fun consumeNotice() { mutable.value = mutable.value.copy(notice = null) }
+
+    fun create(name: String, target: BigDecimal?) {
+        when {
+            name.isBlank() -> fail(SavingsGoalFormError.Name)
+            target == null || !validBudgetLimit(target) -> fail(SavingsGoalFormError.Amount)
+            else -> write(SavingsGoalNotice.Created) { goals.create(name, target, null) }
+        }
+    }
+
+    /**
+     * [clientId] is minted here, once per attempt, so a repeated submit is replayed by the server's receipt rather
+     * than posting the contribution twice.
+     */
+    fun contribute(goalId: Int, amount: BigDecimal?, date: LocalDate, note: String?) {
+        if (amount == null || !validBudgetLimit(amount)) return fail(SavingsGoalFormError.Amount)
+        write(SavingsGoalNotice.Contributed) {
+            goals.contribute(goalId, amount, date, note, UUID.randomUUID())
+        }
+    }
+
+    /** Cancels with the goal's current row version as the If-Match precondition. */
+    fun cancel(goal: SavingsGoal) = write(SavingsGoalNotice.Cancelled) { goals.cancel(goal.goalId, goal.version) }
+
+    private fun fail(error: SavingsGoalFormError) { mutable.value = mutable.value.copy(formError = error) }
+
+    private fun write(success: SavingsGoalNotice, block: suspend () -> FinanceResult<*>) {
+        if (mutable.value.saving || mutable.value.invalidated) return
+        if (!isSessionCurrent()) { expire(); return }
+        // Never write against figures that could not be refreshed: there is no offline queue for goals.
+        if (mutable.value.stale) return fail(SavingsGoalFormError.Stale)
+        mutable.value = mutable.value.copy(saving = true, formError = null)
+        write = viewModelScope.launch {
+            val result = safely { block() }
+            if (!isSessionCurrent()) { expire(); return@launch }
+            when (result) {
+                is FinanceResult.Success -> {
+                    mutable.value = mutable.value.copy(saving = false,
+                        savedCount = mutable.value.savedCount + 1, notice = success)
+                    refresh() // The server ledger is the source of truth: reread after every confirmed write.
+                }
+                is FinanceResult.Failure -> {
+                    if (result.reason.isSession()) { expire(); return@launch }
+                    // An unconfirmed request may still have been applied, so reload instead of guessing.
+                    val error = when (result.reason) {
+                        FinanceFailure.Conflict -> SavingsGoalFormError.Stale
+                        FinanceFailure.InvalidInput -> SavingsGoalFormError.Rejected
+                        FinanceFailure.NotFound -> SavingsGoalFormError.NotFound
+                        FinanceFailure.Timeout, FinanceFailure.InvalidResponse, FinanceFailure.Unavailable ->
+                            SavingsGoalFormError.Failed
+                        else -> SavingsGoalFormError.Failed
+                    }
+                    mutable.value = mutable.value.copy(saving = false, formError = error)
+                    if (error != SavingsGoalFormError.Rejected) refresh()
+                }
+            }
+        }
+    }
+
+    private suspend fun <T> safely(block: suspend () -> FinanceResult<T>): FinanceResult<T> =
+        try { block() } catch (c: CancellationException) { throw c } catch (_: Exception) {
+            FinanceResult.Failure(FinanceFailure.Unavailable)
+        }
+
+    private fun expire() {
+        if (mutable.value.invalidated) return
+        load?.cancel(); write?.cancel()
+        mutable.value = SavingsGoalsState(invalidated = true)
+        onSessionExpired()
+    }
+
+    private companion object { const val PAGE_SIZE = 100; const val MAX_PAGES = 10 }
+}
+
+private fun FinanceFailure.isSession() = this == FinanceFailure.MissingSession || this == FinanceFailure.SessionExpired
