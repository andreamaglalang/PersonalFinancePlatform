+package com.elect3.mobdev.personalfinance.domain.repository
+
+import java.math.BigDecimal
+import java.time.LocalDate
+
+/** Mirrors the API's SavingsGoalStatus. Cancelled goals are financially immutable server-side. */
+enum class SavingsGoalStatus { Active, Completed, Cancelled }
+
+/**
+ * Mirrors the API SavingsGoalResponse. Saved, remaining, surplus and progress are computed by the server from the
+ * contribution ledger; the app displays them and never recomputes them.
+ */
+data class SavingsGoal(
+    val goalId: Int,
+    val name: String,
+    val targetAmount: BigDecimal,
+    val targetDate: LocalDate?,
+    val status: SavingsGoalStatus,
+    val savedAmount: BigDecimal,
+    val remainingAmount: BigDecimal,
+    val surplusAmount: BigDecimal,
+    val progressPercentage: BigDecimal,
+    val baseCurrency: String,
+    /** Server row version. Sent verbatim as the If-Match precondition; never reused after a mutation. */
+    val version: String,
+)
+
+data class SavingsGoalPage(val items: List<SavingsGoal>, val page: Int, val pageSize: Int, val totalCount: Long)
+
+/** api/savings-goals. */
+interface SavingsGoalRepository {
+    /** One page. Callers page until [SavingsGoalPage.totalCount] is reached. */
+    suspend fun list(status: SavingsGoalStatus?, page: Int, pageSize: Int): FinanceResult<SavingsGoalPage>
+    suspend fun create(name: String, targetAmount: BigDecimal, targetDate: LocalDate?): FinanceResult<SavingsGoal>
+
+    /**
+     * Adds a contribution. [clientId] must be fresh per attempt: the server stores the receipt and replays it for
+     * a repeated ClientId instead of posting twice. A repeated attempt is therefore safe, never silently doubled.
+     */
+    suspend fun contribute(goalId: Int, amount: BigDecimal, contributedOn: LocalDate, note: String?,
+        clientId: java.util.UUID): FinanceResult<SavingsGoal>
+
+    /** Requires the goal's current [version] as the If-Match precondition; a stale version is a 428/400. */
+    suspend fun cancel(goalId: Int, version: String): FinanceResult<SavingsGoal>
+}
