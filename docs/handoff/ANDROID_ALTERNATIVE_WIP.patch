+import com.elect3.mobdev.personalfinance.domain.repository.SavingsGoalRepository
+import com.elect3.mobdev.personalfinance.domain.repository.SavingsGoalStatus
+import com.elect3.mobdev.personalfinance.testutil.MainDispatcherRule
+import com.elect3.mobdev.personalfinance.testutil.MutableAuthClock
+import com.elect3.mobdev.personalfinance.ui.savings.SavingsGoalsViewModel
+import com.google.gson.JsonParser
+import java.math.BigDecimal
+import java.net.SocketTimeoutException
+import java.time.Instant
+import java.time.LocalDate
+import java.util.UUID
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.test.advanceUntilIdle
+import kotlinx.coroutines.test.runTest
+import org.junit.Assert.*
+import org.junit.Rule
+import org.junit.Test
+
+/** Savings goals: exact API fields, If-Match precondition, receipt replay and no guessed writes. */
+@OptIn(ExperimentalCoroutinesApi::class)
+class SavingsGoalTest {
+    @get:Rule val main = MainDispatcherRule()
+    private val expiry = Instant.parse("2030-01-01T00:15:00Z")
+    private val version = "AAAAAAAAAAA="   // 12-char base64 of an 8-byte rowversion
+
+    private fun goal(id: Int, saved: String = "100.00", status: SavingsGoalStatus = SavingsGoalStatus.Active,
+                     target: String = "500.00") = SavingsGoal(id, "Goal $id", BigDecimal(target),
+        LocalDate.of(2030, 6, 1), status, BigDecimal(saved), BigDecimal(target) - BigDecimal(saved),
+        BigDecimal(saved).subtract(BigDecimal(target)), BigDecimal("20.00"), "PHP", version)
+
+    private inner class Fixture(config: ApiConfiguration = ApiConfiguration.https("https://localhost:7027/")) {
+        val clock = MutableAuthClock(expiry.minusSeconds(60))
+        val auth = InMemoryAuthRepository(object : AuthApi {
+            override suspend fun login(email: String, password: String): ApiResult<AuthPayload> = ApiResult.Success(
+                AuthPayload("offline-access", "offline-refresh", expiry, expiry.plusSeconds(1000),
+                    AuthUser(42, "Offline", "offline@example.test", "PHP", listOf("User"))))
+            override suspend fun logout(refreshToken: String): ApiResult<Unit> = ApiResult.Success(Unit)
+        }, clock)
+        val sent = mutableListOf<FinanceWriteRequest>()
+        var respond: (FinanceWriteRequest) -> FinanceHttpResponse =
+            { FinanceHttpResponse(201, goalJson(7, it.body!!)) }
+        val repos = FinanceRepositories(config, auth, FinanceHttpEngine { error("no GET expected") },
+            writeEngine = FinanceWriteEngine { sent += it; respond(it) })
+        suspend fun login() = assertEquals(AuthResult.Success, auth.login("offline@example.test", "fixture-only"))
+    }
+
+    private fun goalJson(id: Int, requestBody: String): String {
+        val body = JsonParser.parseString(requestBody).asJsonObject
+        val name = body.get("name")?.asString ?: "Goal $id"
+        val target = body.get("targetAmount")?.asBigDecimal ?: BigDecimal("500.00")
+        return """
+            {"goalId":$id,"name":"$name","targetAmount":$target,"targetDate":null,"status":"Active",
+             "savedAmount":0,"remainingAmount":$target,"surplusAmount":${BigDecimal.ZERO - target},
+             "progressPercentage":0,"baseCurrency":"PHP","version":"$version"}
+        """.trimIndent()
+    }
+
+    @Test fun createPostsExactlyTheApiFields() = runTest {
+        val f = Fixture(); f.login()
+        val created = (f.repos.savingsGoals.create("  Travel fund  ", BigDecimal("2500.00"), null)
+            as FinanceResult.Success).value
+        val request = f.sent.single()
+        assertEquals(WriteMethod.POST, request.method)
+        assertEquals("/api/savings-goals", request.url.path)
+        assertEquals("Bearer offline-access", request.authorization())
+        val json = JsonParser.parseString(request.body).asJsonObject
+        assertEquals(setOf("name", "targetAmount", "targetDate"), json.keySet())
+        assertEquals("Travel fund", json["name"].asString)
+        assertEquals(0, json["targetAmount"].asBigDecimal.compareTo(BigDecimal("2500.00")))
+        assertEquals("Travel fund", created.name)
+        assertTrue(request.headers.isEmpty())
+        assertFalse(request.toString().contains("offline-access"))
+    }
+
+    @Test fun contributeSendsAFreshClientIdAndAcceptsTheReceiptReplay() = runTest {
+        val f = Fixture(); f.login()
+        f.respond = { FinanceHttpResponse(201, contributionJson(it.body!!)) }
+        assertTrue(f.repos.savingsGoals.contribute(7, BigDecimal("25.00"), LocalDate.of(2026, 11, 23), "first",
+            UUID.fromString("11111111-1111-1111-1111-111111111111")) is FinanceResult.Success)
+        val create = f.sent.last()
+        assertEquals("/api/savings-goals/7/contributions", create.url.path)
+        val body = JsonParser.parseString(create.body).asJsonObject
+        assertEquals(setOf("clientId", "amount", "contributedOn", "note"), body.keySet())
+        assertEquals("11111111-1111-1111-1111-111111111111", body["clientId"].asString)
+
+        // A retained receipt answers 200 instead of 201; both mean the contribution is recorded.
+        f.respond = { FinanceHttpResponse(200, contributionJson(it.body!!)) }
+        assertTrue(f.repos.savingsGoals.contribute(7, BigDecimal("25.00"), LocalDate.of(2026, 11, 23), null,
+            UUID.randomUUID()) is FinanceResult.Success)
+    }
+
+    private fun contributionJson(requestBody: String): String {
+        val body = JsonParser.parseString(requestBody).asJsonObject
+        val clientId = body["clientId"].asString
+        val amount = body["amount"].asBigDecimal
+        val date = body["contributedOn"].asString
+        return """
+            {"receipt":{"requestId":1,"clientId":"$clientId","goalId":7,"contributionId":4,
+              "originalAmount":$amount,"originalContributedOn":"$date","originalNote":null,
+              "canonicalVersion":1,"recordedAtUtc":"2026-11-23T00:00:00","deletedAtUtc":null,"baseCurrency":"PHP"},
+             "replayed":false,"deleted":false,
+             "currentContribution":{"contributionId":4,"goalId":7,"amount":$amount,"contributedOn":"$date",
+               "note":null,"baseCurrency":"PHP","version":"$version"},
+             "goal":{"goalId":7,"name":"Goal 7","targetAmount":500.00,"targetDate":null,"status":"Active",
+               "savedAmount":$amount,"remainingAmount":${BigDecimal("500.00") - amount},
+               "surplusAmount":${amount - BigDecimal("500.00")},"progressPercentage":5,
+               "baseCurrency":"PHP","version":"$version"}}
+        """.trimIndent()
+    }
+
+    @Test fun cancelSendsTheGoalVersionAsAStrongIfMatchTag() = runTest {
+        val f = Fixture(); f.login()
+        val cancelled = goalJson(7, "{}").replace("\"status\":\"Active\"", "\"status\":\"Cancelled\"")
+        f.respond = { FinanceHttpResponse(200, cancelled) }
+        val result = f.repos.savingsGoals.cancel(7, version)
+        assertTrue(result is FinanceResult.Success)
+        val request = f.sent.last()
+        assertEquals(WriteMethod.POST, request.method)
+        assertEquals("/api/savings-goals/7/cancel", request.url.path)
+        assertEquals("\"$version\"", request.headers["If-Match"])
+        assertNull(request.body)
+        assertEquals(SavingsGoalStatus.Cancelled, (result as FinanceResult.Success).value.status)
+    }
+
+    @Test fun aStaleVersionIsRejectedRatherThanRetriedBlindly() = runTest {
+        val f = Fixture(); f.login()
+        // A malformed tag never leaves the device: the API would answer 400/428.
+        assertEquals(FinanceResult.Failure(FinanceFailure.InvalidInput), f.repos.savingsGoals.cancel(7, "short"))
+        assertTrue(f.sent.none { it.url.path.contains("cancel") })
+        f.respond = { FinanceHttpResponse(428, "stale") }
+        assertEquals(FinanceResult.Failure(FinanceFailure.InvalidResponse), f.repos.savingsGoals.cancel(7, version))
+        f.respond = { throw SocketTimeoutException() }
+        assertEquals(FinanceResult.Failure(FinanceFailure.Timeout), f.repos.savingsGoals.cancel(7, version))
+    }
+
+    @Test fun contradictoryFiguresAreRejectedInsteadOfDisplayed() = runTest {
+        val f = Fixture(); f.login()
+        f.respond = { FinanceHttpResponse(201, goalJson(7, "{}").replace("\"remainingAmount\":500.00",
+            "\"remainingAmount\":499.00")) }
+        assertEquals(FinanceResult.Failure(FinanceFailure.InvalidResponse),
+            f.repos.savingsGoals.create("Goal", BigDecimal("500.00"), null))
+    }
+
+    // ---------- ViewModel ----------
+
+    private inner class FakeGoals(private val onCancel: (Int, String) -> Unit = { _, _ -> }) : SavingsGoalRepository {
+        val created = mutableListOf<Pair<String, BigDecimal>>()
+        val contributed = mutableListOf<Triple<Int, BigDecimal, UUID>>()
+        var cancelled = 0
+        var listResult: FinanceResult<SavingsGoalPage> = FinanceResult.Success(
+            SavingsGoalPage(emptyList(), 1, 100, 0))
+        var failWith: FinanceFailure? = null
+
+        override suspend fun list(status: SavingsGoalStatus?, page: Int, pageSize: Int) = listResult
+        override suspend fun create(name: String, targetAmount: BigDecimal, targetDate: LocalDate?): FinanceResult<SavingsGoal> {
+            if (failWith != null) return FinanceResult.Failure(failWith!!)
+            created += name to targetAmount
+            return FinanceResult.Success(goal(created.size, target = targetAmount.toString()))
+        }
+        override suspend fun contribute(goalId: Int, amount: BigDecimal, contributedOn: LocalDate, note: String?,
+            clientId: UUID): FinanceResult<SavingsGoal> {
+            if (failWith != null) return FinanceResult.Failure(failWith!!)
+            contributed += Triple(goalId, amount, clientId)
+            return FinanceResult.Success(goal(goalId, saved = amount.toString()))
+        }
+        override suspend fun cancel(goalId: Int, version: String): FinanceResult<SavingsGoal> {
+            if (failWith != null) return FinanceResult.Failure(failWith!!)
+            onCancel(goalId, version); cancelled++
+            return FinanceResult.Success(goal(goalId, status = SavingsGoalStatus.Cancelled))
+        }
+    }
+
+    @Test fun theViewModelMintsOneClientIdPerContributionAndCancelsWithTheRowVersion() = runTest {
+        val repo = FakeGoals()
+        val vm = SavingsGoalsViewModel(repo)
+        advanceUntilIdle()
+        vm.create("Travel", BigDecimal("900.00")); advanceUntilIdle()
+        assertEquals(listOf("Travel" to BigDecimal("900.00")), repo.created)
+
+        vm.contribute(1, BigDecimal("50.00"), LocalDate.of(2026, 11, 23), null); advanceUntilIdle()
+        val first = repo.contributed.single().third
+        vm.contribute(1, BigDecimal("50.00"), LocalDate.of(2026, 11, 23), null); advanceUntilIdle()
+        val second = repo.contributed.last().third
+        assertNotEquals("each attempt must present a fresh ClientId", first, second)
+
+        val active = goal(1)
+        vm.cancel(active); advanceUntilIdle()
+        assertEquals(1, repo.cancelled)
+    }
+
+    @Test fun aStaleReadBlocksWritesUntilItSucceedsAgain() = runTest {
+        val repo = FakeGoals()
+        val vm = SavingsGoalsViewModel(repo)
+        advanceUntilIdle()
+        repo.listResult = FinanceResult.Failure(FinanceFailure.Unavailable)
+        vm.refresh(); advanceUntilIdle()
+        assertTrue(vm.state.value.stale)
+        assertFalse(vm.state.value.canWrite)
+        vm.create("Blocked", BigDecimal("10.00")); advanceUntilIdle()
+        assertTrue("a stale read must not be written against", repo.created.isEmpty())
+
+        repo.listResult = FinanceResult.Success(SavingsGoalPage(emptyList(), 1, 100, 0))
+        vm.refresh(); advanceUntilIdle()
+        assertTrue(vm.state.value.canWrite)
+        vm.create("Allowed", BigDecimal("10.00")); advanceUntilIdle()
+        assertEquals(listOf("Allowed" to BigDecimal("10.00")), repo.created)
+    }
+
+    @Test fun invalidAmountsAreRejectedBeforeAnyRequest() = runTest {
+        val repo = FakeGoals()
+        val vm = SavingsGoalsViewModel(repo)
+        advanceUntilIdle()
+        vm.create("Goal", BigDecimal("0")); advanceUntilIdle()
+        vm.contribute(1, BigDecimal("-1"), LocalDate.now(), null); advanceUntilIdle()
+        assertTrue(repo.created.isEmpty())
+        assertTrue(repo.contributed.isEmpty())
+        assertNotNull(vm.state.value.formError)
+    }
+}
