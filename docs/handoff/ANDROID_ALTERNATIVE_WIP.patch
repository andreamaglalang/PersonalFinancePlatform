+
+private val decimalKeyboard: KeyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Decimal)
+
+/**
+ * Recurring bills for the signed-in account. Every due date and amount comes from the server; the app never
+ * advances a schedule itself. Payments are online only, because a bill has no offline queue.
+ */
+@Composable
+fun RecurringBillsSection(
+    state: RecurringBillsState,
