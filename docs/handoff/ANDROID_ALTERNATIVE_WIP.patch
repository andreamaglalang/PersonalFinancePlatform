+package com.elect3.mobdev.personalfinance.data.local
+
+import com.elect3.mobdev.personalfinance.domain.repository.CategoryRepository
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+
+/** Durable, per-session record of which account has already been warmed. */
+interface WarmUpStateStore {
+    fun isWarmed(accountKey: String): Boolean
+    fun markWarmed(accountKey: String)
+}
+
+/**
+ * Runs the category warm-up at most once per account/session, and only records success.
+ *
+ * - [WarmUpStateStore] is the durable flag, so an activity recreation does not repeat the requests.
+ * - A failed attempt is retried a bounded number of times with a delay; the account is marked warmed only after
+ *   [CategoryCacheWarmer.warm] reports full success, so a later entry point can still retry a failure.
+ * - A mutex makes overlapping calls no-ops, so recomposition or a second entry point cannot duplicate requests.
+ */
+class CategoryCacheWarmUpGuard(
+    private val store: WarmUpStateStore,
+    private val sleeper: suspend (Long) -> Unit = { delay(it) },
+    private val maxAttempts: Int = 3,
+    private val retryDelayMillis: Long = 2_000,
+) {
+    private val mutex = Mutex()
+
+    /** @return true when the cache is warmed for [accountKey] after this call. */
+    suspend fun warm(accountKey: String, repository: CategoryRepository): Boolean {
+        if (accountKey.isBlank()) return false
+        if (store.isWarmed(accountKey)) return true
+        if (!mutex.tryLock()) return store.isWarmed(accountKey)
+        try {
+            for (attempt in 1..maxAttempts) {
+                if (store.isWarmed(accountKey)) return true
+                if (CategoryCacheWarmer.warm(repository)) {
+                    store.markWarmed(accountKey)
+                    return true
+                }
+                if (attempt < maxAttempts) sleeper(retryDelayMillis)
+            }
+            return false
+        } finally {
+            mutex.unlock()
+        }
+    }
+}
