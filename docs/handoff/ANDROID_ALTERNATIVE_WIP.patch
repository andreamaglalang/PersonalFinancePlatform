+
+class CategoryCacheWarmUpGuardTest {
+    private fun cat(id: Int, type: TransactionType = TransactionType.Expense) =
+        Category(id, "Synthetic $id", type, null, isActive = true, isSystemDefault = true)
+
+    /** Durable stand-in for the saveable Compose flag; survives "activity recreation" within a test. */
+    private class InMemoryWarmUpStore : WarmUpStateStore {
+        val warmed = mutableSetOf<String>()
+        override fun isWarmed(accountKey: String) = accountKey in warmed
+        override fun markWarmed(accountKey: String) { warmed += accountKey }
+    }
+
+    private class RecordingRepository(
+        private val onList: suspend (CategoryQuery) -> FinanceResult<CategoryPage>,
+    ) : CategoryRepository {
+        val calls = mutableListOf<CategoryQuery>()
+        override suspend fun list(query: CategoryQuery): FinanceResult<CategoryPage> {
+            calls += query
+            return onList(query)
+        }
+    }
+
+    private fun success(query: CategoryQuery) = FinanceResult.Success(
+        CategoryPage(listOf(cat(1, query.type ?: TransactionType.Expense)), query.page,
+            CategoryCacheWarmer.PageSize, 1))
+
+    @Test fun successfulWarmIsRecordedAndNeverRepeated() = runTest {
+        val repo = RecordingRepository { success(it) }
+        val store = InMemoryWarmUpStore()
+        val guard = CategoryCacheWarmUpGuard(store, sleeper = {})
+
+        assertTrue(guard.warm("session-1", repo))
+        assertTrue(store.isWarmed("session-1"))
+        assertEquals(2, repo.calls.size)   // Expense + Income, one page each
+
+        // A recreation re-creates the guard over the same durable flag: no further requests.
+        val recreated = CategoryCacheWarmUpGuard(store, sleeper = {})
+        assertTrue(recreated.warm("session-1", repo))
+        assertEquals(2, repo.calls.size)
+    }
+
+    @Test fun failureIsRetriedAndOnlySuccessIsMarked() = runTest {
+        var attempts = 0
+        val repo = RecordingRepository {
+            attempts++
+            if (attempts == 1) FinanceResult.Failure(FinanceFailure.Unavailable, isConnectivityFailure = true)
+            else success(it)
+        }
+        val store = InMemoryWarmUpStore()
+        val guard = CategoryCacheWarmUpGuard(store, sleeper = {})
+
+        assertFalse(store.isWarmed("session-1"))
+        assertTrue(guard.warm("session-1", repo))
+        assertTrue(store.isWarmed("session-1"))
+        assertEquals(4, attempts)   // attempt 1: Expense fails, Income succeeds; attempt 2: both succeed
+    }
+
+    @Test fun exhaustedRetriesAreNotMarkedWarmedSoALaterEntryPointCanRetry() = runTest {
+        var attempts = 0
+        val repo = RecordingRepository {
+            attempts++
+            FinanceResult.Failure(FinanceFailure.Unavailable, isConnectivityFailure = true)
+        }
+        val store = InMemoryWarmUpStore()
+        val guard = CategoryCacheWarmUpGuard(store, sleeper = {}, maxAttempts = 3)
+
+        assertFalse(guard.warm("session-1", repo))
+        assertFalse(store.isWarmed("session-1"))
+        assertEquals(6, attempts)   // 3 attempts x (Expense + Income)
+    }
+
+    @Test fun overlappingCallsWarmOnceAndDoNotDuplicateRequests() = runTest {
+        val repo = RecordingRepository {
+            delay(20)
+            success(it)
+        }
+        val store = InMemoryWarmUpStore()
+        val guard = CategoryCacheWarmUpGuard(store, sleeper = {})
+
+        val outcomes = coroutineScope {
+            val first = async { guard.warm("session-1", repo) }
+            val second = async { guard.warm("session-1", repo) }
+            listOf(first.await(), second.await())
+        }
+        assertTrue(outcomes.any { it })
+        assertEquals(2, repo.calls.size)   // exactly one warm: Expense + Income
+        assertTrue(store.isWarmed("session-1"))
+    }
+
+    @Test fun accountsAndSessionsAreWarmedIndependently() = runTest {
+        var servedAccounts = 0
+        val repo = RecordingRepository {
+            servedAccounts++
+            success(it)
+        }
+        val store = InMemoryWarmUpStore()
+        val sessionOne = CategoryCacheWarmUpGuard(store, sleeper = {})
+
+        assertTrue(sessionOne.warm("session-1", repo))
+        assertTrue(store.isWarmed("session-1"))
+        assertFalse(store.isWarmed("session-2"))
+
+        // A different account/session must warm again; it cannot read the other account's flag.
+        val sessionTwo = CategoryCacheWarmUpGuard(store, sleeper = {})
+        assertTrue(sessionTwo.warm("session-2", repo))
+        assertTrue(store.isWarmed("session-2"))
+        assertEquals(4, servedAccounts)   // two sessions x (Expense + Income)
+    }
+}
