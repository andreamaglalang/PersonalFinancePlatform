+        val updated = mutableListOf<Pair<Int, com.elect3.mobdev.personalfinance.ui.bills.RecurringBillDraft>>()
+        val paid = mutableListOf<Triple<Int, LocalDate, UUID>>()
+        var payResult: FinanceResult<Unit> = FinanceResult.Success(Unit)
+        var payGate: CompletableDeferred<FinanceResult<Unit>>? = null
+        var listResult: FinanceResult<RecurringBillPage> =
+            FinanceResult.Success(RecurringBillPage(emptyList(), 1, 100, 0))
+        override suspend fun list(includeInactive: Boolean, page: Int, pageSize: Int) = listResult
+        override suspend fun create(name: String, categoryId: Int, amount: BigDecimal, currencyCode: String,
+            reminderDaysBefore: Int, isActive: Boolean, frequency: BillFrequency,
+            firstDueDate: LocalDate): FinanceResult<RecurringBill> {
+            val d = com.elect3.mobdev.personalfinance.ui.bills.RecurringBillDraft(name, categoryId, amount,
+                currencyCode, reminderDaysBefore, isActive, frequency, firstDueDate)
+            created += d
+            return FinanceResult.Success(bill(created.size))
+        }
+        override suspend fun update(billId: Int, name: String, categoryId: Int, amount: BigDecimal,
+            currencyCode: String, reminderDaysBefore: Int, isActive: Boolean): FinanceResult<RecurringBill> {
+            updated += billId to com.elect3.mobdev.personalfinance.ui.bills.RecurringBillDraft(name, categoryId,
+                amount, currencyCode, reminderDaysBefore, isActive, BillFrequency.Monthly,
+                LocalDate.of(2030, 1, 1))
+            return FinanceResult.Success(bill(billId))
+        }
+        override suspend fun delete(billId: Int): FinanceResult<Unit> = FinanceResult.Success(Unit)
+        override suspend fun pay(billId: Int, dueDate: LocalDate, clientId: UUID): FinanceResult<Unit> {
+            paid += Triple(billId, dueDate, clientId)
+            return payGate?.await() ?: payResult
+        }
+    }
+
+    private object Categories : CategoryRepository {
+        override suspend fun list(query: CategoryQuery): FinanceResult<CategoryPage> = FinanceResult.Success(
+            CategoryPage(listOf(Category(4, "Housing", TransactionType.Expense, null, true, false)),
+                query.page, query.pageSize, 1))
+    }
+
+    @Test fun theViewModelMintsOneClientIdPerPayment() = runTest {
+        val repo = FakeBills()
+        val vm = RecurringBillsViewModel(repo, Categories)
+        advanceUntilIdle()
+        vm.create(draft); advanceUntilIdle()
+        assertEquals(1, repo.created.size)
+        val bill = bill(1)
+        vm.pay(bill); advanceUntilIdle()
+        vm.pay(bill); advanceUntilIdle()
+        assertNotEquals("each payment attempt must present a fresh ClientId",
+            repo.paid.first().third, repo.paid.last().third)
+        assertEquals(LocalDate.of(2030, 6, 1), repo.paid.first().second)
+    }
+
+    @Test fun paymentFailureFeedbackPersistsUntilExplicitDismissal() = runTest {
+        val repo = FakeBills().apply { payResult = FinanceResult.Failure(FinanceFailure.Conflict) }
+        val vm = RecurringBillsViewModel(repo, Categories)
+        advanceUntilIdle()
+        vm.pay(bill(1)); advanceUntilIdle()
+        assertEquals(BillFormError.Stale, vm.state.value.formError)
+        assertEquals(1, repo.paid.size)
+        assertEquals(null, vm.state.value.notice)
+        vm.clearFormError()
+        assertNull(vm.state.value.formError)
+    }
+
+    @Test fun paymentSuccessFeedbackPersistsUntilExplicitDismissal() = runTest {
+        val vm = RecurringBillsViewModel(FakeBills(), Categories)
+        advanceUntilIdle()
+        vm.pay(bill(1)); advanceUntilIdle()
+        assertEquals(BillNotice.Paid, vm.state.value.notice)
+        assertNull(vm.state.value.formError)
+        vm.consumeNotice()
+        assertNull(vm.state.value.notice)
+    }
+
+    @Test fun startingANewWriteClearsThePreviousSuccessNotice() = runTest {
+        val repo = FakeBills()
+        val vm = RecurringBillsViewModel(repo, Categories)
+        advanceUntilIdle()
+        vm.pay(bill(1)); advanceUntilIdle()
+        assertEquals(BillNotice.Paid, vm.state.value.notice)
+        repo.payResult = FinanceResult.Failure(FinanceFailure.Unavailable)
+        vm.pay(bill(1))
+        assertNull(vm.state.value.notice)
+        advanceUntilIdle()
+        assertEquals(BillFormError.Failed, vm.state.value.formError)
+        assertNull(vm.state.value.notice)
+    }
+
+    @Test fun paymentSubmissionIsBlockedWhileTheFirstAttemptIsProcessing() = runTest {
+        val repo = FakeBills().apply { payGate = CompletableDeferred() }
+        val vm = RecurringBillsViewModel(repo, Categories)
+        advanceUntilIdle()
+        val dueBill = bill(1)
+        vm.pay(dueBill)
+        runCurrent()
+        assertTrue(vm.state.value.saving)
+        assertFalse(vm.state.value.canWrite)
+        vm.pay(dueBill)
+        runCurrent()
+        assertEquals(1, repo.paid.size)
+        repo.payGate!!.complete(FinanceResult.Success(Unit))
+        advanceUntilIdle()
+        assertFalse(vm.state.value.saving)
+        assertEquals(1, repo.paid.size)
+        assertEquals(BillNotice.Paid, vm.state.value.notice)
+    }
+
+    @Test fun aStaleReadBlocksWritesUntilItSucceedsAgain() = runTest {
+        val repo = FakeBills()
+        val vm = RecurringBillsViewModel(repo, Categories)
+        advanceUntilIdle()
+        repo.listResult = FinanceResult.Failure(FinanceFailure.Unavailable)
+        vm.refresh(); advanceUntilIdle()
+        assertFalse(vm.state.value.canWrite)
+        vm.pay(bill(1)); advanceUntilIdle()
+        assertTrue("a stale read must not be written against", repo.paid.isEmpty())
+        repo.listResult = FinanceResult.Success(RecurringBillPage(emptyList(), 1, 100, 0))
+        vm.refresh(); advanceUntilIdle()
+        assertTrue(vm.state.value.canWrite)
+        vm.delete(1); advanceUntilIdle()
+    }
+}
