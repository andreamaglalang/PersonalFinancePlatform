+package com.elect3.mobdev.personalfinance.ui.bills
+
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import com.elect3.mobdev.personalfinance.domain.repository.BillFrequency
+import com.elect3.mobdev.personalfinance.domain.repository.FinanceFailure
+import com.elect3.mobdev.personalfinance.domain.repository.FinanceResult
+import com.elect3.mobdev.personalfinance.domain.repository.RecurringBill
+import com.elect3.mobdev.personalfinance.domain.repository.RecurringBillRepository
+import com.elect3.mobdev.personalfinance.domain.repository.validBudgetLimit
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.launch
+import java.math.BigDecimal
+import java.time.Clock
+import java.time.LocalDate
+import java.time.LocalDateTime
+import java.util.UUID
+
+enum class BillFormError { Name, Amount, Category, Rejected, NotFound, Failed, Stale }
+
+enum class BillNotice { Created, Updated, Paid, Deleted }
+
+/** A bill draft shared by the create and edit forms; the schedule is fixed once created. */
+data class RecurringBillDraft(
+    val name: String,
+    val categoryId: Int,
+    val amount: BigDecimal,
+    val currencyCode: String,
+    val reminderDaysBefore: Int,
+    val isActive: Boolean,
+    val frequency: BillFrequency,
+    val firstDueDate: LocalDate,
+) {
+    val valid: Boolean
+        get() = name.isNotBlank() && name.length <= 100 && categoryId > 0 && validBudgetLimit(amount)
+            && currencyCode.matches(Regex("[A-Z]{3}")) && reminderDaysBefore in 0..30
+}
+
+data class RecurringBillsState(
+    val loading: Boolean = true,
+    val error: FinanceFailure? = null,
+    val bills: List<RecurringBill> = emptyList(),
+    /** Active expense categories, for the create and edit forms. */
+    val categories: List<com.elect3.mobdev.personalfinance.domain.repository.Category> = emptyList(),
+    val categoriesFailed: Boolean = false,
+    val saving: Boolean = false,
+    val formError: BillFormError? = null,
+    val savedCount: Int = 0,
+    val notice: BillNotice? = null,
+    val invalidated: Boolean = false,
+    /** A reload failed while bills were already shown; they stay visible but read-only. */
+    val staleReason: FinanceFailure? = null,
+    val loadedAt: LocalDateTime? = null,
+) {
+    val loaded get() = !loading && error == null
+    val stale get() = staleReason != null
+    val canWrite get() = loaded && !stale && !saving && !invalidated
+}
+
+/**
+ * Recurring bills for the signed-in account, through api/recurring-bills only. There is no offline queue: a payment
+ * is never guessed, so writes are blocked until a reload has succeeded.
+ */
+class RecurringBillsViewModel(
+    private val bills: RecurringBillRepository,
+    private val categories: com.elect3.mobdev.personalfinance.domain.repository.CategoryRepository,
+    private val isSessionCurrent: () -> Boolean = { true },
+    private val onSessionExpired: () -> Unit = {},
+    private val clock: Clock = Clock.systemDefaultZone(),
+) : ViewModel() {
+    private val mutable = MutableStateFlow(RecurringBillsState())
+    val state = mutable.asStateFlow()
+    private var load: Job? = null
+    private var write: Job? = null
+
+    init { refresh() }
+
+    fun refresh() {
+        if (mutable.value.invalidated) return
+        load?.cancel()
+        mutable.value = mutable.value.copy(loading = mutable.value.loadedAt == null, error = null)
+        load = viewModelScope.launch {
+            val result = safely { pageAll() }
+            if (!isSessionCurrent()) { expire(); return@launch }
+            when (result) {
+                is FinanceResult.Success -> {
+                    val cats = loadCategories()
+                    if (cats is FinanceResult.Failure && cats.reason.isSession()) { expire(); return@launch }
+                    mutable.value = mutable.value.copy(loading = false, error = null, staleReason = null,
+                        loadedAt = LocalDateTime.now(clock),
+                        bills = result.value.sortedWith(compareBy({ it.name.lowercase() }, { it.billId })),
+                        categoriesFailed = cats is FinanceResult.Failure,
+                        categories = (cats as? FinanceResult.Success)?.value.orEmpty()
+                            .filter { it.isActive && it.type == com.elect3.mobdev.personalfinance.domain.model.TransactionType.Expense })
+                }
+                is FinanceResult.Failure -> {
+                    if (result.reason.isSession()) { expire(); return@launch }
+                    mutable.value = if (mutable.value.loadedAt != null)
+                        mutable.value.copy(loading = false, staleReason = result.reason)
+                    else mutable.value.copy(loading = false, error = result.reason)
+                }
+            }
+        }
+    }
+
+    private suspend fun pageAll(): FinanceResult<List<RecurringBill>> {
+        val all = ArrayList<RecurringBill>()
+        for (page in 1..MAX_PAGES) {
+            when (val r = safely { bills.list(true, page, PAGE_SIZE) }) {
+                is FinanceResult.Failure -> return r
+                is FinanceResult.Success -> {
+                    all += r.value.items
+                    if (r.value.items.isEmpty() || all.size.toLong() >= r.value.totalCount)
+                        return FinanceResult.Success(all.distinctBy { it.billId })
+                }
+            }
+        }
+        return FinanceResult.Failure(FinanceFailure.InvalidResponse)
+    }
+
+    private suspend fun loadCategories(): FinanceResult<List<com.elect3.mobdev.personalfinance.domain.repository.Category>> {
+        val all = ArrayList<com.elect3.mobdev.personalfinance.domain.repository.Category>()
+        for (page in 1..MAX_CATEGORY_PAGES) {
+            when (val r = safely { categories.list(com.elect3.mobdev.personalfinance.domain.repository.CategoryQuery(
+                type = com.elect3.mobdev.personalfinance.domain.model.TransactionType.Expense,
+                page = page, pageSize = CATEGORY_PAGE_SIZE)) }) {
+                is FinanceResult.Failure -> return r
+                is FinanceResult.Success -> {
+                    all += r.value.items
+                    if (r.value.items.isEmpty() || all.size.toLong() >= r.value.totalCount)
+                        return FinanceResult.Success(all.distinctBy { it.categoryId })
+                }
+            }
+        }
+        return FinanceResult.Success(all.distinctBy { it.categoryId })
+    }
+
+    fun clearFormError() { mutable.value = mutable.value.copy(formError = null) }
+    fun consumeNotice() { mutable.value = mutable.value.copy(notice = null) }
+
+    fun create(draft: RecurringBillDraft) {
+        if (!draft.valid) return fail(if (draft.name.isBlank()) BillFormError.Name else BillFormError.Rejected)
+        write(BillNotice.Created) { bills.create(draft.name, draft.categoryId, draft.amount, draft.currencyCode,
+            draft.reminderDaysBefore, draft.isActive, draft.frequency, draft.firstDueDate) }
+    }
+
+    fun update(billId: Int, draft: RecurringBillDraft) {
+        if (!draft.valid) return fail(if (draft.name.isBlank()) BillFormError.Name else BillFormError.Rejected)
+        write(BillNotice.Updated) { bills.update(billId, draft.name, draft.categoryId, draft.amount,
+            draft.currencyCode, draft.reminderDaysBefore, draft.isActive) }
+    }
+
+    fun delete(billId: Int) = write(BillNotice.Deleted) { bills.delete(billId) }
+
+    /** [clientId] is minted here, once per attempt, so a repeated submit replays the receipt instead of paying twice. */
+    fun pay(bill: RecurringBill) = write(BillNotice.Paid) { bills.pay(bill.billId, bill.nextDueDate, UUID.randomUUID()) }
+
+    private fun fail(error: BillFormError) { mutable.value = mutable.value.copy(formError = error) }
+
+    private fun write(success: BillNotice, block: suspend () -> FinanceResult<*>) {
+        if (mutable.value.saving || mutable.value.invalidated) return
+        if (!isSessionCurrent()) { expire(); return }
+        if (mutable.value.stale) return fail(BillFormError.Stale)
+        mutable.value = mutable.value.copy(saving = true, formError = null, notice = null)
+        write = viewModelScope.launch {
+            val result = safely { block() }
+            if (!isSessionCurrent()) { expire(); return@launch }
+            when (result) {
+                is FinanceResult.Success -> {
+                    mutable.value = mutable.value.copy(saving = false,
+                        savedCount = mutable.value.savedCount + 1, notice = success)
+                    refresh()
+                }
+                is FinanceResult.Failure -> {
+                    if (result.reason.isSession()) { expire(); return@launch }
+                    val error = when (result.reason) {
+                        FinanceFailure.Conflict -> BillFormError.Stale
+                        FinanceFailure.InvalidInput -> BillFormError.Rejected
+                        FinanceFailure.NotFound -> BillFormError.NotFound
+                        else -> BillFormError.Failed
+                    }
+                    mutable.value = mutable.value.copy(saving = false, formError = error)
+                    if (error != BillFormError.Rejected) refresh()
+                }
+            }
+        }
+    }
+
+    private suspend fun <T> safely(block: suspend () -> FinanceResult<T>): FinanceResult<T> =
+        try { block() } catch (c: CancellationException) { throw c } catch (_: Exception) {
+            FinanceResult.Failure(FinanceFailure.Unavailable)
+        }
+
+    private fun expire() {
+        if (mutable.value.invalidated) return
+        load?.cancel(); write?.cancel()
+        mutable.value = RecurringBillsState(invalidated = true)
+        onSessionExpired()
+    }
+
+    private companion object {
+        const val PAGE_SIZE = 100
+        const val MAX_PAGES = 10
+        const val CATEGORY_PAGE_SIZE = 100
+        const val MAX_CATEGORY_PAGES = 10
+    }
+}
+
+private fun FinanceFailure.isSession() = this == FinanceFailure.MissingSession || this == FinanceFailure.SessionExpired
