+package com.elect3.mobdev.personalfinance.domain.repository
+
+import java.math.BigDecimal
+import java.time.LocalDate
+
+/** Mirrors the API's BillFrequency. The schedule is fixed at creation; only the editable fields change later. */
+enum class BillFrequency { Weekly, Monthly, Quarterly, Yearly }
+
+/** Mirrors the API RecurringBillResponse. Next due date is computed by the server, never by the app. */
+data class RecurringBill(
+    val billId: Int,
+    val name: String,
+    val categoryId: Int,
+    val categoryName: String,
+    val amount: BigDecimal,
+    val currencyCode: String,
+    val frequency: BillFrequency,
+    val firstDueDate: LocalDate,
+    val nextDueDate: LocalDate,
+    val reminderDaysBefore: Int,
+    val isActive: Boolean,
+)
+
+data class RecurringBillPage(val items: List<RecurringBill>, val page: Int, val pageSize: Int, val totalCount: Long)
+
+/** api/recurring-bills. */
+interface RecurringBillRepository {
+    /** One page. Callers page until [RecurringBillPage.totalCount] is reached. */
+    suspend fun list(includeInactive: Boolean, page: Int, pageSize: Int): FinanceResult<RecurringBillPage>
+    suspend fun create(name: String, categoryId: Int, amount: BigDecimal, currencyCode: String,
+        reminderDaysBefore: Int, isActive: Boolean, frequency: BillFrequency,
+        firstDueDate: LocalDate): FinanceResult<RecurringBill>
+
+    /** The schedule (frequency, first due date) is fixed at creation and cannot be changed. */
+    suspend fun update(billId: Int, name: String, categoryId: Int, amount: BigDecimal, currencyCode: String,
+        reminderDaysBefore: Int, isActive: Boolean): FinanceResult<RecurringBill>
+
+    suspend fun delete(billId: Int): FinanceResult<Unit>
+
+    /**
+     * Records a payment for the bill's current due date. [clientId] must be fresh per attempt: the server keeps the
+     * receipt and replays it for a repeated ClientId instead of paying twice.
+     */
+    suspend fun pay(billId: Int, dueDate: LocalDate, clientId: java.util.UUID): FinanceResult<Unit>
+}
