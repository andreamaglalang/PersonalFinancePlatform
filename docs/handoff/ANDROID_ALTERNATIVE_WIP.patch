+import com.elect3.mobdev.personalfinance.testutil.MainDispatcherRule
+import java.time.Instant
+import java.time.ZoneId
+import java.util.Locale
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.test.advanceUntilIdle
+import kotlinx.coroutines.test.runTest
+import org.junit.Assert.*
+import org.junit.Rule
+import org.junit.Test
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class NotificationInboxViewModelTest {
+    @get:Rule val main = MainDispatcherRule()
+    private fun item(id: Int) = FinanceNotification(id, "BillReminder", null, null, "Upcoming bill", false,
+        Instant.parse("2026-11-23T10:00:00Z"))
+    private class FakeRepository : NotificationRepository {
+        val queries = mutableListOf<Triple<Boolean, Int, Int>>()
+        var result: FinanceResult<NotificationPage> = FinanceResult.Success(NotificationPage(listOf(
+            FinanceNotification(1, "BillReminder", null, null, "Reminder", false,
+                Instant.parse("2026-11-23T10:00:00Z"))), 1, 20, 21))
+        override suspend fun list(unreadOnly: Boolean, page: Int, pageSize: Int): FinanceResult<NotificationPage> {
+            queries += Triple(unreadOnly, page, pageSize)
+            return result
+        }
+    }
+
+    @Test fun loadsPagesAndAppliesUnreadFilterFromFirstPage() = runTest {
+        val repo = FakeRepository(); val vm = NotificationInboxViewModel(repo)
+        vm.refresh(); advanceUntilIdle()
+        assertEquals(Triple(false, 1, 20), repo.queries.last())
+        assertTrue(vm.state.value.canGoNext)
+        vm.nextPage(); advanceUntilIdle()
+        assertEquals(Triple(false, 2, 20), repo.queries.last())
+        vm.setUnreadOnly(true); advanceUntilIdle()
+        assertEquals(Triple(true, 1, 20), repo.queries.last())
+        assertEquals(1, vm.state.value.page)
+    }
+
+    @Test fun failedRequestIsNotAnEmptyStateAndCanBeRetried() = runTest {
+        val repo = FakeRepository().apply { result = FinanceResult.Failure(FinanceFailure.Unavailable) }
+        val vm = NotificationInboxViewModel(repo)
+        vm.refresh(); advanceUntilIdle()
+        assertEquals(FinanceFailure.Unavailable, vm.state.value.error)
+        assertFalse(vm.state.value.isEmpty)
+        repo.result = FinanceResult.Success(NotificationPage(emptyList(), 1, 20, 0))
+        vm.refresh(); advanceUntilIdle()
+        assertTrue(vm.state.value.isEmpty)
+        assertNull(vm.state.value.error)
+    }
+
+    @Test fun expiredSessionInvalidatesInboxAndCallsGateOnce() = runTest {
+        val repo = FakeRepository().apply { result = FinanceResult.Failure(FinanceFailure.SessionExpired) }
+        var expired = 0
+        val vm = NotificationInboxViewModel(repo, onSessionExpired = { expired++ })
+        vm.refresh(); advanceUntilIdle(); vm.refresh(); advanceUntilIdle()
+        assertTrue(vm.state.value.sessionExpired)
+        assertEquals(1, expired)
+        assertEquals(1, repo.queries.size)
+    }
+
+    @Test fun utcTimestampUsesRequestedLocalZoneAndLocale() {
+        val instant = Instant.parse("2026-11-23T23:30:00Z")
+        val rendered = notificationTimestampText(instant, ZoneId.of("Asia/Manila"), Locale.US)
+        assertTrue(rendered.contains("Nov 24, 2026"))
+    }
+}
