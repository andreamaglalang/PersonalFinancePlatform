+    var name by rememberSaveable { mutableStateOf("") }
+    var categoryId by rememberSaveable { mutableStateOf<Int?>(null) }
+    var amount by rememberSaveable { mutableStateOf("") }
+    var currency by rememberSaveable { mutableStateOf("PHP") }
+    var reminder by rememberSaveable { mutableStateOf("7") }
+    var frequency by rememberSaveable { mutableStateOf(BillFrequency.Monthly) }
+    var firstDue by rememberSaveable { mutableStateOf(LocalDate.now().toString()) }
+
+    val typography = LocalOwliTypography.current
+    val scheme = MaterialTheme.colorScheme
+    val owli = LocalOwliColors.current
+
+    LaunchedEffect(state.savedCount) {
+        if (state.savedCount > 0) { creating = false; editing = null; name = ""; amount = "" }
+    }
+    fun draft(): RecurringBillDraft = RecurringBillDraft(name.trim(), categoryId ?: 0,
+        amount.toBigDecimalOrNull() ?: BigDecimal.ZERO, currency, reminder.toIntOrNull() ?: 0, true, frequency,
+        runCatching { LocalDate.parse(firstDue) }.getOrDefault(LocalDate.now()))
+    Column(modifier.fillMaxWidth().padding(start = 20.dp, end = 20.dp, top = 16.dp),
+        verticalArrangement = Arrangement.spacedBy(12.dp)) {
+        Row(Modifier.fillMaxWidth(), verticalAlignment = Alignment.CenterVertically) {
+            Text(stringResource(R.string.plan_bills_title), style = typography.bodyStrong,
+                modifier = Modifier.weight(1f).semantics { heading() })
+            TextButton(onClick = { creating = !creating; editing = null }) {
+                Text(stringResource(R.string.bills_new))
+            }
+        }
+
+        if (creating || editing != null) {
+            Column(Modifier.fillMaxWidth().clip(RoundedCornerShape(20.dp))
+                .border(1.dp, owli.hairline, RoundedCornerShape(20.dp)).padding(16.dp),
+                verticalArrangement = Arrangement.spacedBy(10.dp)) {
+                OutlinedTextField(name, { name = it }, label = { Text(stringResource(R.string.bills_name)) },
+                    singleLine = true, modifier = Modifier.fillMaxWidth())
+                OutlinedTextField(categoryId?.toString().orEmpty(), { value ->
+                    categoryId = value.filter { it.isDigit() }.toIntOrNull()
+                }, label = { Text(stringResource(R.string.bills_category_id)) }, singleLine = true,
+                    keyboardOptions = decimalKeyboard, modifier = Modifier.fillMaxWidth())
+                OutlinedTextField(amount, { amount = it }, label = { Text(stringResource(R.string.bills_amount)) },
+                    singleLine = true, keyboardOptions = decimalKeyboard, modifier = Modifier.fillMaxWidth())
+                OutlinedTextField(reminder, { value ->
+                    reminder = value.filter { it.isDigit() }
+                }, label = { Text(stringResource(R.string.bills_reminder)) }, singleLine = true,
+                    modifier = Modifier.fillMaxWidth())
+                if (creating) {
+                    OutlinedTextField(frequency.name, { value ->
+                        frequency = BillFrequency.entries.firstOrNull { it.name.equals(value, ignoreCase = true) }
+                            ?: BillFrequency.Monthly
+                    }, label = { Text(stringResource(R.string.bills_frequency)) }, singleLine = true,
+                        modifier = Modifier.fillMaxWidth())
+                    OutlinedTextField(firstDue, { firstDue = it },
+                        label = { Text(stringResource(R.string.bills_first_due)) }, singleLine = true,
+                        modifier = Modifier.fillMaxWidth())
+                }
+                Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.spacedBy(10.dp)) {
+                    TextButton(onClick = { creating = false; editing = null }) {
+                        Text(stringResource(R.string.bills_cancel))
+                    }
+                    TextButton(onClick = {
+                        if (creating) onCreate(draft()) else editing?.let { onUpdate(it, draft()) }
+                    }, enabled = state.canWrite) { Text(stringResource(R.string.bills_save)) }
+                }
+            }
+        }
+
+        when {
+            state.bills.isEmpty() && state.loaded -> Text(stringResource(R.string.bills_empty),
+                style = typography.caption, color = scheme.onSurfaceVariant, textAlign = TextAlign.Center,
+                modifier = Modifier.fillMaxWidth().padding(vertical = 18.dp))
+            else -> state.bills.forEach { bill ->
+                Column(Modifier.fillMaxWidth().clip(RoundedCornerShape(20.dp))
+                    .border(1.dp, owli.hairline, RoundedCornerShape(20.dp)).padding(16.dp),
+                    verticalArrangement = Arrangement.spacedBy(6.dp)) {
+                    Text(bill.name, style = typography.bodyStrong)
+                    Text("${bill.categoryName} � ${bill.amount} ${bill.currencyCode} � ${bill.frequency}",
+                        style = typography.caption, color = scheme.onSurfaceVariant)
+                    Text(stringResource(R.string.bills_next_due, bill.nextDueDate.toString()),
+                        style = typography.caption, color = scheme.onSurfaceVariant)
+                    Row(horizontalArrangement = Arrangement.spacedBy(10.dp)) {
+                        TextButton(onClick = { onPay(bill) },
+                            enabled = state.canWrite && bill.isActive) {
+                            Text(stringResource(if (state.saving) R.string.bills_working else R.string.bills_pay))
+                        }
+                        TextButton(onClick = { editing = bill.billId; creating = false; name = bill.name
+                            categoryId = bill.categoryId; amount = bill.amount.toString() },
+                            enabled = state.canWrite) { Text(stringResource(R.string.bills_edit)) }
+                        TextButton(onClick = { onDelete(bill.billId) }, enabled = state.canWrite) {
+                            Text(stringResource(R.string.bills_delete))
+                        }
+                    }
+                }
+            }
+        }
+
+        state.formError?.let { error ->
+            Row(Modifier.fillMaxWidth(), verticalAlignment = Alignment.CenterVertically) {
+                Text(errorMessage(error), style = typography.caption, color = MaterialTheme.colorScheme.error,
+                    modifier = Modifier.weight(1f))
+                TextButton(onClick = onClearError) { Text(stringResource(R.string.bills_dismiss)) }
+            }
+        }
+        state.notice?.let { notice ->
+            Row(Modifier.fillMaxWidth(), verticalAlignment = Alignment.CenterVertically) {
+                Text(noticeMessage(notice), style = typography.caption, color = scheme.primary,
+                    modifier = Modifier.weight(1f))
+                TextButton(onClick = onConsumeNotice) { Text(stringResource(R.string.bills_dismiss)) }
+            }
+        }
+        state.staleReason?.let {
+            Text(stringResource(R.string.savings_goal_error_stale), style = typography.caption,
+                color = scheme.onSurfaceVariant, modifier = Modifier.fillMaxWidth())
+        }
+    }
+}
+
+@Composable
+private fun noticeMessage(notice: BillNotice): String = stringResource(when (notice) {
+    BillNotice.Created -> R.string.bills_notice_created
+    BillNotice.Updated -> R.string.bills_notice_updated
+    BillNotice.Paid -> R.string.bills_notice_paid
+    BillNotice.Deleted -> R.string.bills_notice_deleted
+})
+
+@Composable
+private fun errorMessage(error: BillFormError): String = stringResource(when (error) {
+    BillFormError.Name -> R.string.savings_goal_error_name
+    BillFormError.Amount, BillFormError.Category, BillFormError.Rejected -> R.string.savings_goal_error_amount
+    BillFormError.Stale -> R.string.bills_error_stale
+    BillFormError.NotFound, BillFormError.Failed -> R.string.bills_error_failed
+})
