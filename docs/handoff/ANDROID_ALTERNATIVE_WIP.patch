@@ -0,0 +1,44 @@
+package com.elect3.mobdev.personalfinance.data.local
+
+import com.elect3.mobdev.personalfinance.domain.model.TransactionType
+import com.elect3.mobdev.personalfinance.domain.repository.CategoryPage
+import com.elect3.mobdev.personalfinance.domain.repository.CategoryQuery
+import com.elect3.mobdev.personalfinance.domain.repository.CategoryRepository
+import com.elect3.mobdev.personalfinance.domain.repository.FinanceResult
+
+/**
+ * Fills the device Room category cache for one authenticated session so the Add Transaction screen can offer
+ * Expense and Income categories while offline.
+ *
+ * Pages until the server says the active list is complete; a partial page is never assumed to be the whole list.
+ * A failure stops that type only � the other type still warms and whatever the cache already held is kept.
+ * Account isolation is preserved because [CategoryRepository] is scoped to the signed-in account id.
+ */
+object CategoryCacheWarmer {
+    /** Large enough to usually finish in one request; pagination still guards larger lists. */
+    const val PageSize = 100
+
+    /** True only when both Expense and Income completed; a failure of either type reports false so the caller can retry. */
+    suspend fun warm(repository: CategoryRepository): Boolean {
+        // Explicit order: the Add screen defaults to Expense, so it warms first. Never depends on enum order.
+        // Both types are attempted even if one fails, so a partial outage still warms the other type.
+        val expense = warmType(repository, TransactionType.Expense)
+        val income = warmType(repository, TransactionType.Income)
+        return expense && income
+    }
+
+    private suspend fun warmType(repository: CategoryRepository, type: TransactionType): Boolean {
+        var page = 1
+        while (true) {
+            val result = repository.list(CategoryQuery(type = type, includeInactive = false,
+                page = page, pageSize = PageSize))
+            if (result is FinanceResult.Failure) return false
+            val snapshot = (result as FinanceResult.Success).value
+            // Trust the server's own page/total contract; stop on anything inconsistent rather than looping.
+            if (snapshot.page != page || snapshot.items.isEmpty()) return true
+            if (snapshot.items.size.toLong() >= snapshot.totalCount) return true
+            if (snapshot.items.size.toLong() < snapshot.pageSize) return true
+            page += 1
+        }
+    }
+}
